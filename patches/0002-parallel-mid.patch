+    def _parallel_mid_entries(self, mid_targets, jobs):
+        """Lift independent mid-function tails across worker processes.
+
+        Each tail is re-disassembled from its own 4-byte-aligned byte range and
+        lifted by a fresh Lifter with the parent's configuration, so the workers
+        share no mutable state. Results come back in input order.
+        """
+        import multiprocessing as mp
+        cfg = {
+            "prefix": self.prefix, "weak": self.weak_emit,
+            "hle": self.hle_stub_nids, "jump": self.jump_tables,
+            "patches": self.insn_patches, "names": self.name_map,
+            "entries": self.function_entries,
+            "lo": self.code_lo, "hi": self.code_hi,
+        }
+        procs = max(1, min(jobs, len(mid_targets)))
+        with mp.Pool(processes=procs, initializer=_mid_init,
+                     initargs=(self.seg_blobs, self.big_endian, cfg)) as pool:
+            return pool.map(_mid_task, mid_targets,
+                            chunksize=max(1, len(mid_targets) // (procs * 8)))
