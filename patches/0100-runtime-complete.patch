+        if (e && *e) { printf("[pad] KZ2_PAD_PRESET=%s: %s\n", e, env < 0 ? "unknown value, ignored" : "pad layout forced"); fflush(stdout); }
+    }
+    prm_identity(&cust);
+#ifdef _WIN32
+    AcquireSRWLockShared(&s_kb_lock);
