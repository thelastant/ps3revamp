+static void pad_sdl_sync(unsigned long long now)
+{
+    int lost = 0;
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++)
+        if (s_sdl_controllers[p] && !PSDL(SDL_GamepadConnected)(s_sdl_controllers[p])) lost = 1;
+    if (!lost && s_sdl_enum_ms && now - s_sdl_enum_ms < PAD_SDL_ENUM_MS) return;
+    s_sdl_enum_ms = now;
+
+    int ids[16], n = 0, num = 0;
+    uint32_t* list = PSDL(SDL_GetGamepads)(&num);
+    for (int i = 0; list && i < num && n < 16; i++) ids[n++] = (int)list[i];
+    if (list) PSDL(SDL_free)(list);
+    unsigned changed = pad_slots_sync(s_sdl_slot_id, PAD_MAX_HOST_PORTS, ids, n);
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) {
+        if (!(changed & (1u << p))) continue;
+        if (s_sdl_controllers[p]) { PSDL(SDL_CloseGamepad)(s_sdl_controllers[p]); s_sdl_controllers[p] = NULL; }
+        s_host_state[p].connected = 0;
+        s_port_dev[p] = PAD_DEV_NONE;
+        s_port_motion[p] = 0;
+        s_rumble_lo[p] = s_rumble_hi[p] = 0;
+        memset(&s_sdl_sensors[p], 0, sizeof s_sdl_sensors[p]);
+        if (s_sdl_slot_id[p] < 0) { printf("[pad] port %d: disconnected\n", p); fflush(stdout); continue; }
+        PadSdlGamepad* gc = s_sdl_controllers[p] = PSDL(SDL_OpenGamepad)((uint32_t)s_sdl_slot_id[p]);
+        if (!gc) {
+            printf("[pad] port %d: open failed (%s)\n", p, PSDL(SDL_GetError)());
+            s_sdl_slot_id[p] = -1;
+        } else {
+            pad_sdl_open_log(p, gc, (uint32_t)s_sdl_slot_id[p], now);
+        }
+        fflush(stdout);
+    }
+}
