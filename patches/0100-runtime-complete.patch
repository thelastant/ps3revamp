+/* The table the Options row (keybinds.ini [pad]) selects; KZ2_PAD_PRESET=default|modern|custom (tests) before it. */
+static void pad_remap_refresh(void)
+{
+    static int env = -2;
+    PadRemap cust, m[2];
+    int preset = PRM_DEFAULT_PRESET, f;
+    uint32_t sig[2];
+    if (env == -2) {
