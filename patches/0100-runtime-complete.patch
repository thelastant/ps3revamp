+            who, how, name, (unsigned long)luid.HighPart, (unsigned long)luid.LowPart, vendor, device, flags, software, vram >> 20,
+            have_fl ? (unsigned)fl.MaxSupportedFeatureLevel : 0u, have_o ? (int)o.ResourceBindingTier : -1,
+            have_o ? (int)o.TypedUAVLoadAdditionalFormats : -1, (unsigned)sm.HighestShaderModel);
+    return software;
+}
+
+#define RSX_MAX_ADAPTERS 16
+/* Every adapter in EnumAdapterByGpuPreference(HIGH_PERFORMANCE) order (EnumAdapters1 order on a DXGI without
+ * IDXGIFactory6), one "[d3d12] adapter" line each. -> count; ads[] are AddRef'd (the caller releases). */
+static int rsx_enum_adapters(IDXGIFactory4* f, const char* who, rsx_adapter_info* infos, IDXGIAdapter1** ads)
+{
+    IDXGIFactory6* f6 = NULL;
+    const int have6 = f && SUCCEEDED(f->lpVtbl->QueryInterface(f, &IID_IDXGIFactory6, (void**)&f6)) && f6;
+    int n = 0;
+    for (UINT i = 0; n < RSX_MAX_ADAPTERS; i++) {
+        IDXGIAdapter1* ad = NULL;
+        HRESULT hr = have6 ? f6->lpVtbl->EnumAdapterByGpuPreference(f6, i, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE,
+                                                                    &IID_IDXGIAdapter1, (void**)&ad)
+                           : (f ? f->lpVtbl->EnumAdapters1(f, i, &ad) : DXGI_ERROR_NOT_FOUND);
+        if (FAILED(hr) || !ad) break;
+        DXGI_ADAPTER_DESC1 d;
+        if (FAILED(ad->lpVtbl->GetDesc1(ad, &d))) { ad->lpVtbl->Release(ad); continue; }
+        char name[256] = "?";
+        WideCharToMultiByte(CP_UTF8, 0, d.Description, -1, name, (int)sizeof name, NULL, NULL);
+        infos[n].vendor = d.VendorId; infos[n].device = d.DeviceId; infos[n].flags = d.Flags;
+        infos[n].software = (d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0;
+        fprintf(stderr, "[d3d12] adapter %d (%s, %s): \"%s\" vendor=0x%04X device=0x%04X flags=0x%X software=%d "
+                        "luid=%08lX:%08lX vram=%llu MB\n", n, who, have6 ? "gpu-preference order" : "EnumAdapters1 order",
+                name, d.VendorId, d.DeviceId, d.Flags,
+                rsx_adapter_is_software(infos[n].software, d.VendorId, d.DeviceId), (unsigned long)d.AdapterLuid.HighPart,
+                (unsigned long)d.AdapterLuid.LowPart, (unsigned long long)(d.DedicatedVideoMemory >> 20));
+        ads[n++] = ad;
+    }
+    if (f6) f6->lpVtbl->Release(f6);
+    if (!n) fprintf(stderr, "[d3d12] no adapter enumerated (%s)\n", who);
+    return n;
+}
+
+typedef struct {
+    IDXGIFactory4* f; ID3D12Device** out; IDXGIAdapter1** ads; const rsx_adapter_info* infos; int n;
+    const char* who; int mode;
+} rsx_try_ctx;
+/* One creation attempt (rsx_pick_device's callback), logged with its HRESULT. */
+static int rsx_try_create(void* vctx, int which)
+{
+    rsx_try_ctx* c = (rsx_try_ctx*)vctx;
+    IUnknown* adapter = NULL;
+    IDXGIAdapter* warp = NULL;
+    HRESULT hr;
+    *c->out = NULL;
+    if (which >= 0) adapter = (IUnknown*)c->ads[which];
+    else if (which == RSX_PICK_WARP) {
+        hr = c->f ? c->f->lpVtbl->EnumWarpAdapter(c->f, &IID_IDXGIAdapter, (void**)&warp) : E_POINTER;
+        if (FAILED(hr) || !warp) {
+            fprintf(stderr, "[d3d12] ERROR: EnumWarpAdapter failed (hr=0x%08lX)\n", (unsigned long)hr);
+            return 0;
+        }
+        adapter = (IUnknown*)warp;
+    }
+    hr = D3D12CreateDevice(adapter, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)c->out);
+    if (warp) warp->lpVtbl->Release(warp);
+    const int ok = SUCCEEDED(hr) && *c->out;
+    if (which >= 0)
+        fprintf(stderr, "[d3d12] D3D12CreateDevice on adapter %d (%s): hr=0x%08lX%s\n", which, c->who, (unsigned long)hr,
+                ok ? " ok" : ", next");
+    else
+        fprintf(stderr, "[d3d12] D3D12CreateDevice on %s (%s): hr=0x%08lX%s\n",
+                which == RSX_PICK_WARP ? "WARP" : "the default adapter", c->who, (unsigned long)hr,
+                ok ? " ok" : (which == RSX_PICK_DEFAULT && c->mode == RSX_WARP_AUTO ? ", trying WARP"
+                              : c->mode == RSX_WARP_NEVER ? "; RSX_D3D12_WARP=0: no WARP fallback" : ""));
+    if (!ok) { *c->out = NULL; return 0; }
+    return 1;
+}
+
+/* The device by the adapter order and RSX_D3D12_WARP rules (above). -> 0 = a hardware or the default adapter, 1 = WARP,
+ * -1 = no device. */
+static int rsx_d3d12_create_device(IDXGIFactory4* f, ID3D12Device** out, const char* who)
+{
+    *out = NULL;
+    int bad = 0;
+    const int mode = rsx_warp_mode_parse(getenv("RSX_D3D12_WARP"), &bad);
+    if (bad) fprintf(stderr, "[d3d12] RSX_D3D12_WARP=%s not understood (1 = WARP only, 0 = never, fail = none): auto\n", getenv("RSX_D3D12_WARP"));
+    if (mode == RSX_WARP_FAIL) { fprintf(stderr, "[d3d12] RSX_D3D12_WARP=fail: no D3D12 device (test)\n"); return -1; }
+    rsx_adapter_info infos[RSX_MAX_ADAPTERS];
+    IDXGIAdapter1* ads[RSX_MAX_ADAPTERS];
+    int n = 0;
+    if (rsx_warp_try_hw(mode)) n = rsx_enum_adapters(f, who, infos, ads);
+    rsx_try_ctx tc = {f, out, ads, infos, n, who, mode};
+    const int which = rsx_pick_device(mode, infos, n, rsx_try_create, &tc);
+    for (int i = 0; i < n; i++) ads[i]->lpVtbl->Release(ads[i]);
+    if (which == RSX_PICK_NONE) {
+        fprintf(stderr, "[d3d12] ERROR: no D3D12 device on any adapter (%s)\n", who);
+        return -1;
+    }
+    if (which != RSX_PICK_WARP) {
+        if (rsx_d3d12_log_device(*out, f, who, which >= 0 ? "high-performance adapter" : "default adapter") == 1)
+            fprintf(stderr, "[d3d12] the chosen adapter is a software rasteriser (no GPU driver): expect a few fps\n");
+        return 0;
+    }
+    const int sw = rsx_d3d12_log_device(*out, f, who, mode == RSX_WARP_FORCE ? "WARP, forced" : "WARP, fallback");
+    if (sw == 0)   /* vkd3d-proton's DXGI answers EnumWarpAdapter with a hardware adapter */
+        fprintf(stderr, "[d3d12] WARP requested (%s) but EnumWarpAdapter gave a hardware adapter (Proton has no "
+                        "WARP): this run is not a WARP test\n", mode == RSX_WARP_FORCE ? "RSX_D3D12_WARP=1" : "fallback");
+    else
+        fprintf(stderr, "[d3d12] WARP (software rasteriser) in use: %s; expect a few fps\n",
+                mode == RSX_WARP_FORCE ? "RSX_D3D12_WARP=1" : "no hardware D3D12 device");
+    return 1;
+}
+#endif /* _WIN32 */
+#endif
