-    if (!by) return SPU_FF_ZY;
-    if (bx == 255 || by == 255) return SPU_FF_EXT;
-    if (bx - by > 29 || by - bx > 29) return SPU_FF_GAP;
-    return SPU_FF_RANGE;
-}
