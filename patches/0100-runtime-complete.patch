+    if (!log) return;
+    if (n > 60) n = 60;
+    snprintf(m, sizeof m, "line %d: %s '%.*s' (ignored)", line, what, (int)n, s);
+    log(ctx, m);
+}
+
+static int pad_kb_space(char c) { return c == ' ' || c == '\t' || c == '\r'; }
+
+/* Parse `text` over the bindings already in *kb (start from pad_kb_defaults). Returns the number of problems
+ * logged (0 = clean file). Never fails. */
+static int pad_kb_parse(PadKeybinds* kb, const char* text, PadKbLog log, void* ctx)
+{
+    const char* p = text;
+    int line = 0, bad = 0, in_kb = 1, in_pr = 0, in_pd = 0;
+    if (!text) return 0;
+    if ((unsigned char)p[0] == 0xEF && (unsigned char)p[1] == 0xBB && (unsigned char)p[2] == 0xBF) p += 3;
+    while (*p) {
+        const char* e = p;
+        const char *a, *b, *eq, *c;
+        while (*e && *e != '\n') e++;
+        line++;
+        /* strip the comment and the blanks around the line */
+        for (c = p; c < e && *c != '#' && *c != ';'; c++) {}
+        a = p; b = c;
+        while (a < b && pad_kb_space(*a)) a++;
+        while (b > a && pad_kb_space(b[-1])) b--;
+        if (a < b) {
+            if (*a == '[') {
+                const char* r = memchr(a, ']', (size_t)(b - a));
+                if (!r) { pad_kb_logf(log, ctx, line, "broken section header", a, (size_t)(b - a)); bad++; in_kb = in_pr = in_pd = 0; }
+                else {
+                    in_kb = pad_kb_ieq(a + 1, (size_t)(r - a - 1), "keyboard");
+                    in_pr = pad_kb_ieq(a + 1, (size_t)(r - a - 1), "prompts");   /* 4011 */
+                    in_pd = pad_kb_ieq(a + 1, (size_t)(r - a - 1), "pad");        /* 4013 */
+                    if (!in_kb && !in_pr && !in_pd) { pad_kb_logf(log, ctx, line, "section not read by this version", a, (size_t)(r - a + 1)); }
+                }
+            } else if (in_pd) {
+                /* 4013: "preset = default|modern|custom" and "<game button> = <host button>|none" (custom table) */
+                const char* q = memchr(a, '=', (size_t)(b - a));
+                const char *ne = q, *v = q ? q + 1 : NULL;
+                int gi, vi;
+                if (!q) { pad_kb_logf(log, ctx, line, "no '=' in", a, (size_t)(b - a)); bad++; }
+                else {
+                    while (ne > a && pad_kb_space(ne[-1])) ne--;
+                    while (v < b && pad_kb_space(*v)) v++;
+                    if (pad_kb_ieq(a, (size_t)(ne - a), "preset")) {
+                        if ((vi = prm_preset_by_name(v, (size_t)(b - v))) < 0) { pad_kb_logf(log, ctx, line, "unknown pad preset", v, (size_t)(b - v)); bad++; }
+                        else kb->padmap = (unsigned char)vi;
+                    } else if ((gi = prm_button_by_name(a, (size_t)(ne - a))) < 0) {
+                        pad_kb_logf(log, ctx, line, "unknown pad setting", a, (size_t)(ne - a)); bad++;
+                    } else if (pad_kb_ieq(v, (size_t)(b - v), "none")) {
+                        kb->padc[gi] = PRM_NONE;
+                    } else if ((vi = prm_button_by_name(v, (size_t)(b - v))) < 0) {
+                        pad_kb_logf(log, ctx, line, "unknown pad button", v, (size_t)(b - v)); bad++;
+                    } else kb->padc[gi] = (unsigned char)vi;
+                }
+            } else if (in_pr) {
+                /* 4011: "buttons = auto|ps3|ps4|xbox|keyboard"; anything else is logged and the value kept */
+                const char* q = memchr(a, '=', (size_t)(b - a));
+                const char *ne = q, *v = q ? q + 1 : NULL;
+                int pv;
+                if (!q) { pad_kb_logf(log, ctx, line, "no '=' in", a, (size_t)(b - a)); bad++; }
+                else {
+                    while (ne > a && pad_kb_space(ne[-1])) ne--;
+                    while (v < b && pad_kb_space(*v)) v++;
+                    if (!pad_kb_ieq(a, (size_t)(ne - a), "buttons")) { pad_kb_logf(log, ctx, line, "unknown prompts setting", a, (size_t)(ne - a)); bad++; }
+                    else if ((pv = pad_kb_prompts_by_name(v, (size_t)(b - v))) < 0) { pad_kb_logf(log, ctx, line, "unknown prompts value", v, (size_t)(b - v)); bad++; }
+                    else kb->prompts = (unsigned char)pv;
+                }
+            } else if (in_kb) {
+                eq = memchr(a, '=', (size_t)(b - a));
+                if (!eq) { pad_kb_logf(log, ctx, line, "no '=' in", a, (size_t)(b - a)); bad++; }
+                else {
+                    const char* ne = eq;
+                    int in;
+                    while (ne > a && pad_kb_space(ne[-1])) ne--;
+                    in = pad_kb_input_by_name(a, (size_t)(ne - a));
+                    if (in < 0) { pad_kb_logf(log, ctx, line, "unknown pad input", a, (size_t)(ne - a)); bad++; }
+                    else {
+                        unsigned char got[PKB_SLOTS] = { 0 };
+                        int ng = 0, nbad = 0, nnone = 0;
+                        const char* t = eq + 1;
+                        while (t < b) {
+                            const char* te;
+                            const char* tb;
+                            int vk;
+                            while (t < b && (pad_kb_space(*t) || *t == ',')) t++;
+                            if (t >= b) break;
+                            tb = t;
+                            for (te = t; te < b && *te != ','; te++) {}
+                            t = te;
+                            while (te > tb && pad_kb_space(te[-1])) te--;
+                            vk = pad_kb_key_by_name(tb, (size_t)(te - tb));
+                            if (vk < 0) { pad_kb_logf(log, ctx, line, "unknown key", tb, (size_t)(te - tb)); bad++; nbad++; }
+                            else if (vk == 0) nnone++;
+                            else if (ng >= PKB_SLOTS) { pad_kb_logf(log, ctx, line, "more than two keys, extra key", tb, (size_t)(te - tb)); bad++; }
+                            else got[ng++] = (unsigned char)vk;
+                        }
+                        if (ng == 0 && nbad > 0 && nnone == 0) {
+                            pad_kb_logf(log, ctx, line, "no usable key, default kept for", a, (size_t)(ne - a));
+                        } else {
+                            kb->key[in][0] = got[0];
+                            kb->key[in][1] = got[1];
+                        }
+                    }
+                }
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return bad;
+}
+
+/* Is `vk` held? The poller supplies the host query (GetAsyncKeyState on Windows, a table in the test). */
+typedef int (*PadKbDown)(void* ctx, int vk);
+
+static PadKbState pad_kb_eval(const PadKeybinds* kb, PadKbDown down, void* ctx)
+{
+    PadKbState st = { 0, 0 };
+    int i, s;
+    for (i = 0; i < PKB_N_INPUTS; i++)
+        for (s = 0; s < PKB_SLOTS; s++)
+            if (kb->key[i][s] && down(ctx, kb->key[i][s])) {
+                if (pad_kb_inputs[i].dir >= 0) st.dirs |= (unsigned char)(1u << pad_kb_inputs[i].dir);
+                else st.buttons |= pad_kb_inputs[i].btn;
+                break;
+            }
+    return st;
+}
+
+/* KZ2 patch 4020: which bound keys went down this poll, for the prompt-device switch (KZ2 4016 took the edge from
+ * the held state of the previous poll). While the window is not in front (or the bindings page captures keys) the
+ * keys read as up; the first poll back in front takes the keys held at that moment as the baseline instead of as
+ * presses. A key already down when the window comes back (the click that brought it to the front, a key the overlay
+ * or the desktop kept held across a focus change, as around Steam's F12 screenshot) is not a press made in the game,
+ * and it switched the prompts to keycaps once per focus change (hand session 2026-10-22: six switches, all on R1's
+ * binding, Mouse1 / O; F12 itself is unbound and never counted). Starts in the baseline state, so a key held while
+ * the game starts does not count either. */
+typedef struct { PadKbState held; int baseline; } PadKbEdge;
+
+static inline void pad_kb_edge_init(PadKbEdge* e) { e->held.buttons = 0; e->held.dirs = 0; e->baseline = 1; }
+
+static inline PadKbState pad_kb_edge(PadKbEdge* e, int in_front, PadKbState now)
+{
+    PadKbState fresh = { 0, 0 };
+    if (!in_front) { e->held = fresh; e->baseline = 1; return fresh; }
+    if (e->baseline) { e->baseline = 0; e->held = now; return fresh; }
+    fresh.buttons = (unsigned short)(now.buttons & ~e->held.buttons);
+    fresh.dirs = (unsigned char)(now.dirs & ~e->held.dirs);
+    e->held = now;
+    return fresh;
+}
+
+/* KZ2 patch 4020: the names of the held keys behind the inputs in `st` ("r1:Mouse1 cross:Space"), for the log. */
+static inline void pad_kb_names(const PadKeybinds* kb, PadKbState st, PadKbDown down, void* ctx, char* buf, size_t n)
+{
+    size_t o = 0;
+    int i, s;
+    if (n) buf[0] = 0;
+    for (i = 0; i < PKB_N_INPUTS; i++) {
+        int hit = pad_kb_inputs[i].dir >= 0 ? (st.dirs >> pad_kb_inputs[i].dir) & 1 : (st.buttons & pad_kb_inputs[i].btn) != 0;
+        if (!hit) continue;
+        for (s = 0; s < PKB_SLOTS; s++)
+            if (kb->key[i][s] && down(ctx, kb->key[i][s])) {
+                int w = snprintf(buf + o, o < n ? n - o : 0, "%s%s:%s", o ? " " : "", pad_kb_inputs[i].name,
+                                 pad_kb_key_name(kb->key[i][s]));
+                if (w > 0) o += (size_t)w;
+                if (o >= n) return;
+                break;
+            }
+    }
+}
+
+/* Stick axis from two opposite directions: both or neither = centre (128), else 0 or 255 (full deflection, also
+ * on a diagonal; ASSUMPTION: the game's own dead zone and response curve want the raw range like a DS3 corner). */
+static unsigned char pad_kb_axis(unsigned char dirs, int neg, int pos)
+{
+    int n = (dirs >> neg) & 1, q = (dirs >> pos) & 1;
+    return (unsigned char)(n == q ? 128 : n ? 0 : 255);
+}
+
+/* Write the bindings as the file's text. Returns the length (like snprintf; > n-1 = truncated). */
+static int pad_kb_format(const PadKeybinds* kb, char* buf, size_t n)
+{
+    size_t o = 0;
+    int i;
+#define PKB_PUT(...) do { int w_ = snprintf(buf + (o < n ? o : n), o < n ? n - o : 0, __VA_ARGS__); \
+                          if (w_ > 0) o += (size_t)w_; } while (0)
+    PKB_PUT("# Project Pyrrhus (Killzone 2 PC) key bindings. Written with the defaults on the first start; edit and save, the game\n"
+            "# reads it again within two seconds. Delete this file to get the defaults back.\n"
+            "#\n"
+            "#   <pad input> = <primary key>, <secondary key>      (\"none\" or nothing = unbound)\n"
+            "#\n"
+            "# Keys: A-Z 0-9 F1-F12 Space Enter Escape Tab Backspace CapsLock LeftShift RightShift LeftCtrl\n"
+            "#   RightCtrl LeftAlt RightAlt Up Down Left Right Insert Delete Home End PageUp PageDown Pause\n"
+            "#   Numpad0-Numpad9 NumpadAdd NumpadSubtract NumpadMultiply NumpadDivide NumpadDecimal Semicolon\n"
+            "#   Equals Comma Minus Period Slash Grave LeftBracket RightBracket Backslash Apostrophe\n"
+            "#   Mouse1 (left) Mouse2 (right) Mouse3 (middle) Mouse4 Mouse5\n"
+            "# Sticks: hold two keys of one stick for a diagonal. A pad plugged in works at the same time.\n"
+            "# The uses listed are those of the Standard controller preset (Options > Controls).\n"
+            "\n[keyboard]\n");
+    for (i = 0; i < PKB_N_INPUTS; i++) {
+        char v[64];
+        if (!kb->key[i][0] && !kb->key[i][1]) snprintf(v, sizeof v, "none");
+        else if (!kb->key[i][1]) snprintf(v, sizeof v, "%s", pad_kb_key_name(kb->key[i][0]));
+        else if (!kb->key[i][0]) snprintf(v, sizeof v, "none, %s", pad_kb_key_name(kb->key[i][1]));
+        else snprintf(v, sizeof v, "%s, %s", pad_kb_key_name(kb->key[i][0]), pad_kb_key_name(kb->key[i][1]));
+        PKB_PUT("%-9s= %-22s# %s\n", pad_kb_inputs[i].name, v, pad_kb_inputs[i].what);
+    }
+    PKB_PUT("\n[prompts]\n"
+            "# Button pictures in the game (Options > Controls > Button prompts): auto = the device you used last,\n"
+            "# or always ps3, ps4 (PS4/PS5), xbox, keyboard.\n"
+            "buttons  = %s\n", pkb_prompt_names[kb->prompts < PKB_N_PROMPTS ? kb->prompts : 0]);
+    /* 4013 */
+    PKB_PUT("\n[pad]\n"
+            "# Pad buttons (Options > Controls > Controller layout): default = the game's own scheme, modern = a\n"
+            "# modern-shooter layout (PlayStation pads: fire R1, aim L1, grenade L2; Xbox pads: fire RT, aim LT,\n"
+            "# grenade LB; crouch on B/Circle, melee on R3), custom = the lines below. Left of '=' is the\n"
+            "# game's button, right of it the pad button that presses it (names are the PS3 ones: l2 = LT on an Xbox\n"
+            "# pad), or none. A button not listed stays on itself.\n"
+            "preset   = %s\n", prm_preset_names[kb->padmap < PRM_N_PRESETS ? kb->padmap : PRM_DEFAULT_PRESET]);
+    for (i = 0; i < PRM_N; i++)
+        if (kb->padc[i] != i)
+            PKB_PUT("%-9s= %s\n", prm_names[i], kb->padc[i] < PRM_N ? prm_names[kb->padc[i]] : "none");
+#undef PKB_PUT
+    return (int)o;
+}
+
+/* kz2-install.ini (written by the installer / portable zip, read by tools/release/launch.py read_ini): is
+ * [install] portable = 1? Same rule as launch.py: portable only when the value is exactly "1". */
+static int pad_kb_ini_portable(const char* text)
+{
+    const char* p = text;
+    int in_install = 0;
+    if (!text) return 0;
+    while (*p) {
+        const char* e = p;
+        const char *a, *b;
+        while (*e && *e != '\n') e++;
+        a = p; b = e;
+        while (a < b && pad_kb_space(*a)) a++;
+        while (b > a && pad_kb_space(b[-1])) b--;
+        if (a < b && *a == '[') {
+            const char* r = memchr(a, ']', (size_t)(b - a));
+            in_install = r && r - a - 1 == 7 && memcmp(a + 1, "install", 7) == 0;   /* configparser: case-sensitive */
+        } else if (in_install && a < b && *a != '#' && *a != ';') {
+            const char* eq = a;
+            while (eq < b && *eq != '=' && *eq != ':') eq++;
+            if (eq < b) {
+                const char* ke = eq;
+                const char* v = eq + 1;
+                while (ke > a && pad_kb_space(ke[-1])) ke--;
+                while (v < b && pad_kb_space(*v)) v++;
+                if (pad_kb_ieq(a, (size_t)(ke - a), "portable")) return (b - v == 1 && *v == '1');
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return 0;
+}
+
+/* ---- KZ3 patch 2038 (hook A/B): the in-game Keyboard page ----
+ * The page (a GUM served by the port, port/kz3/main.cpp) asks the host through text commands
+ * (pad_kb_ui_command); the capture of the next key runs in the pad poll (pad_kb_ui_step). Both are platform-free so
+ * the host test drives them with a fake key state. Rows are the page's order. The page shows the game's own action
+ * name for a pad button row (the GUM reads settings:controllerconfigs/activeconfig/<button> at run time, so it is the
+ * player's language and active preset); `label` is the port's own fallback (file comments, host tests) and
+ * the page text for the eight stick directions and Start, which have no string of their own in the game. */
+typedef struct { const char* input; const char* label; const char* button; } PadKbRow;
+/* KZ2 patch 2122: the rows in the KZ2 page's order, which is pad_kb_inputs' (the keybinds.ini order: 16 buttons, then
+ * the 8 stick directions; port/kz2/kz2_menu_text.h KB_INPUTS, tools/re/kbpage.py). KZ3's order (sticks first, the
+ * KZ3 GUM's) made the KZ2 page show and capture the wrong input: its row 0 "D-PAD UP" answered "key 0 0" with
+ * ls_up's W, and a capture there rebound Move forward (run kz2-r47-m6). */
+static const PadKbRow pad_kb_rows[] = {
+    { "up", "Up", "Up" },                 { "down", "Down", "Down" },
+    { "left", "Left", "Left" },           { "right", "Right", "Right" },
+    { "cross", "Jump", "Cross" },         { "circle", "Use", "Circle" },
+    { "square", "Reload", "Square" },     { "triangle", "Next weapon", "Triangle" },
+    { "l1", "Melee", "Shoulder_Left_1" }, { "r1", "Fire", "Shoulder_Right_1" },
+    { "l2", "Crouch", "Shoulder_Left_2" }, { "r2", "Grenade", "Shoulder_Right_2" },
+    { "l3", "Sprint", "Left_Analog" },    { "r3", "Zoom", "Right_Analog" },
+    { "start", "Pause", 0 },              { "select", "Objectives", "Select" },
+    { "ls_up", "Move forward", 0 },       { "ls_down", "Move back", 0 },
+    { "ls_left", "Strafe left", 0 },      { "ls_right", "Strafe right", 0 },
+    { "rs_up", "Look up", 0 },            { "rs_down", "Look down", 0 },
+    { "rs_left", "Turn left", 0 },        { "rs_right", "Turn right", 0 },
+};
+#define PKB_N_ROWS ((int)(sizeof pad_kb_rows / sizeof pad_kb_rows[0]))
+
+#define PKB_VK_CANCEL 0x1B      /* Escape: cancels a capture (so the page cannot bind it; the file can) */
+#define PKB_VK_CLEAR  0x2E      /* Delete: clears the slot being captured */
+#define PKB_CAPTURE_MS 10000ull /* a capture with no key for this long ends by itself */
+
+enum { PKB_UI_IDLE, PKB_UI_RELEASE, PKB_UI_WAIT };                    /* PadKbUi.phase */
+enum { PKB_R_NONE, PKB_R_BOUND, PKB_R_CANCEL, PKB_R_CLEARED, PKB_R_TIMEOUT };  /* PadKbUi.result */
+
+typedef struct {
+    int phase;                  /* PKB_UI_*: RELEASE = waiting until every key is up (the key that opened it) */
+    int row, slot;              /* what is being captured */
+    unsigned long long t0;      /* capture start, ms */
+    unsigned long long t_wait;  /* when the RELEASE phase ended, ms */
+    int result, vk;             /* how the last capture ended, and its key */
+    unsigned gen, seen_gen;     /* gen counts binding changes; "poll" reports one once */
+    int suppress;               /* after a capture: keys stay away from the game until all are up */
+    int sel, sel_slot;          /* the page's selected cell + 1 ("sel R S"; 0 = page closed, so a zeroed
+                                 * PadKbUi has none): Delete clears it */
+} PadKbUi;
+
+static int pad_kb_row_input(int row)
+{
+    if (row < 0 || row >= PKB_N_ROWS) return -1;
+    return pad_kb_input_by_name(pad_kb_rows[row].input, strlen(pad_kb_rows[row].input));
+}
+
+static int pad_kb_key_uses(const PadKeybinds* kb, int vk)       /* how many inputs have this key (either slot) */
+{
+    int i, n = 0;
+    if (!vk) return 0;
+    for (i = 0; i < PKB_N_INPUTS; i++) if (kb->key[i][0] == vk || kb->key[i][1] == vk) n++;
+    return n;
+}
+
+/* Bind vk to (input, slot). The same key in the input's other slot is cleared there (one key, one slot). */
+static void pad_kb_assign(PadKeybinds* kb, int input, int slot, int vk)
+{
+    if (input < 0 || input >= PKB_N_INPUTS || slot < 0 || slot >= PKB_SLOTS) return;
+    if (vk && kb->key[input][!slot] == vk) kb->key[input][!slot] = 0;
+    kb->key[input][slot] = (unsigned char)vk;
+}
+
+/* End the capture with key vk (PKB_VK_CANCEL / PKB_VK_CLEAR are the special keys). 1 = bindings changed. */
+static int pad_kb_ui_key(PadKbUi* u, PadKeybinds* kb, int vk)
+{
+    int in = pad_kb_row_input(u->row);
+    u->phase = PKB_UI_IDLE; u->suppress = 1; u->vk = vk;
+    if (vk == PKB_VK_CANCEL || in < 0) { u->result = PKB_R_CANCEL; return 0; }
+    if (vk == PKB_VK_CLEAR) { pad_kb_assign(kb, in, u->slot, 0); u->result = PKB_R_CLEARED; }
+    else { pad_kb_assign(kb, in, u->slot, vk); u->result = PKB_R_BOUND; }
+    u->gen++;
+    return 1;
+}
+
+/* Once per pad poll. down() is the real key state (zero when the window has no focus). 1 = bindings changed (save).
+ * While a capture runs, and after it until every key is up, the caller must not pass keys to the game. */
+static int pad_kb_ui_step(PadKbUi* u, PadKeybinds* kb, PadKbDown down, void* ctx, unsigned long long now)
+{
+    int i, first = 0;
+    for (i = 0; i < PKB_N_KEYS; i++)
+        if (down(ctx, pad_kb_keys[i].vk)) { first = pad_kb_keys[i].vk; break; }
+    if (u->phase == PKB_UI_IDLE) {
+        if (u->suppress && !first) u->suppress = 0;
+        /* Delete on the page (no capture running) clears the selected cell. sel is set only while the
+         * page is open (the page sends "sel R S" from its timer; "sel -1 -1" and "cancel" end it). suppress = one clear per press. */
+        if (!u->suppress && u->sel > 0 && down(ctx, PKB_VK_CLEAR)) {
+            int in = pad_kb_row_input(u->sel - 1);
+            u->suppress = 1;
+            if (in >= 0 && kb->key[in][u->sel_slot]) {
+                pad_kb_assign(kb, in, u->sel_slot, 0); u->result = PKB_R_CLEARED; u->gen++;
+                return 1;
+            }
+        }
+        return 0;
+    }
+    if (now - u->t0 > PKB_CAPTURE_MS) { u->phase = PKB_UI_IDLE; u->suppress = 1; u->result = PKB_R_TIMEOUT; return 0; }
+    if (u->phase == PKB_UI_RELEASE) { if (!first) { u->phase = PKB_UI_WAIT; u->t_wait = now; } return 0; }
+    return first ? pad_kb_ui_key(u, kb, first) : 0;
+}
+
+static int pad_kb_ui_busy(const PadKbUi* u) { return u->phase != PKB_UI_IDLE || u->suppress; }
+
+/* The page's (and keycap prompts') display name: at most 9 characters so it fits one key column in the game's menu
+ * font (the file keeps the full names). Unbound = "---". */
+static const char* pad_kb_key_short(int vk)
+{
+    static const struct { unsigned char vk; const char* s; } t[] = {
+        { 0x01, "Mouse 1" }, { 0x02, "Mouse 2" }, { 0x04, "Mouse 3" }, { 0x05, "Mouse 4" }, { 0x06, "Mouse 5" },
+        { 0x08, "Backspace" }, { 0x0D, "Enter" }, { 0x14, "Caps Lock" }, { 0x1B, "Esc" }, { 0x21, "Page Up" },
+        { 0x22, "Page Down" }, { 0x2D, "Insert" }, { 0x2E, "Delete" },
+        { 0x60, "Num 0" }, { 0x61, "Num 1" }, { 0x62, "Num 2" }, { 0x63, "Num 3" }, { 0x64, "Num 4" },
+        { 0x65, "Num 5" }, { 0x66, "Num 6" }, { 0x67, "Num 7" }, { 0x68, "Num 8" }, { 0x69, "Num 9" },
+        { 0x6A, "Num *" }, { 0x6B, "Num +" }, { 0x6D, "Num -" }, { 0x6E, "Num ." }, { 0x6F, "Num /" },
+        { 0xA0, "L Shift" }, { 0xA1, "R Shift" }, { 0xA2, "L Ctrl" }, { 0xA3, "R Ctrl" }, { 0xA4, "L Alt" },
+        { 0xA5, "R Alt" }, { 0xBA, ";" }, { 0xBB, "=" }, { 0xBC, "," }, { 0xBD, "Minus" }, { 0xBE, "." },
+        { 0xBF, "/" }, { 0xC0, "`" }, { 0xDB, "[" }, { 0xDC, "\\" }, { 0xDD, "]" }, { 0xDE, "'" },
+    };
+    unsigned i;
+    if (!vk) return "---";
+    for (i = 0; i < sizeof t / sizeof t[0]; i++) if (t[i].vk == vk) return t[i].s;
+    return pad_kb_key_name(vk);
+}
+
+static const char* pad_kb_ui_keytext(int vk) { return pad_kb_key_short(vk); }
+
+/* The first key bound to two inputs, in page order: its key and the two rows. 0 = no conflict. */
+static int pad_kb_first_conflict(const PadKeybinds* kb, int* ra, int* rb)
+{
+    int i, j, b;
+    for (i = 0; i < PKB_N_ROWS; i++) {
+        int a = pad_kb_row_input(i);
+        for (j = 0; j < PKB_SLOTS; j++) {
+            int vk = a >= 0 ? kb->key[a][j] : 0;
+            if (pad_kb_key_uses(kb, vk) < 2) continue;
+            for (b = i + 1; b < PKB_N_ROWS; b++) {
+                int c = pad_kb_row_input(b);
+                if (c >= 0 && (kb->key[c][0] == vk || kb->key[c][1] == vk)) { *ra = i; *rb = b; return vk; }
+            }
+        }
+    }
+    return 0;
+}
+
+/* The key the page names for a pad input: `prefer` when it is bound there, else the first bound key (0 = none). */
+static int pad_kb_ui_key_of(const PadKeybinds* kb, const char* input, int prefer)
+{
+    int in = pad_kb_input_by_name(input, strlen(input));
+    if (in < 0) return 0;
+    if (prefer && (kb->key[in][0] == prefer || kb->key[in][1] == prefer)) return prefer;
+    return kb->key[in][0] ? kb->key[in][0] : kb->key[in][1];
+}
+
+/* The idle status line (ui-style.md "Prompts": every input that works): built from the bindings, so it
+ * names the keys the player really has. "Enter change, Delete clear, Left / Right column, R reset, Esc back." */
+static void pad_kb_ui_hint(const PadKeybinds* kb, char* out, size_t n)
+{
+    int ch = pad_kb_ui_key_of(kb, "cross", 0x0D), l = pad_kb_ui_key_of(kb, "left", 0), r = pad_kb_ui_key_of(kb, "right", 0);
+    int rs = pad_kb_ui_key_of(kb, "square", 0), bk = pad_kb_ui_key_of(kb, "start", PKB_VK_CANCEL);
+    char cs[48];
+    size_t m;
+    if (bk != PKB_VK_CANCEL) bk = pad_kb_ui_key_of(kb, "circle", 0);    /* the page's Back is Circle, and Start */
+    snprintf(out, n, "%s%s", ch ? pad_kb_key_short(ch) : "", ch ? " change, " : "");
+    m = strlen(out);
+    snprintf(out + m, n - m, "Delete clear, ");
+    m = strlen(out);
+    if (l && r) { snprintf(cs, sizeof cs, "%s", pad_kb_key_short(l)); snprintf(out + m, n - m, "%s / %s column, ", cs, pad_kb_key_short(r)); }
+    m = strlen(out);
+    if (rs) snprintf(out + m, n - m, "%s reset, ", pad_kb_key_short(rs));
+    m = strlen(out);
+    if (bk) snprintf(out + m, n - m, "%s back, ", pad_kb_key_short(bk));
+    m = strlen(out);
+    if (m >= 2 && out[m - 2] == ',') { out[m - 2] = '.'; out[m - 1] = 0; }
+}
+
+/* One page command; the reply goes to out (always NUL-terminated). Returns 1 when the bindings changed (save them).
+ *   rows                 -> number of rows          label R    -> the row's port label (fallback)
+ *   src R                -> the row's EButton name for settings:controllerconfigs/activeconfig/<name> ("" = none)
+ *   key R S              -> key name of row R slot S ("---" unbound, "..." while captured)
+ *   dup R S              -> "1" when that key is also bound to another input, else ""
+ *   capture R S          -> starts capturing the next key for row R slot S ("ok", or "bad")
+ *   cancel               -> ends a capture and the selection
+ *   sel R S              -> the page's selected cell (Delete clears it); "sel -1 -1" = none
+ *   poll                 -> "busy" | "changed" (once per change) | ""
+ *   reset                -> the default bindings    clear R S  -> unbinds
+ *   state                -> "capture" | "timeout" | "conflict" | "idle" (what the footer shows)
+ *   cf key|a|b           -> the first conflict: its key name, the first and the second row number
+ *   cap                  -> the row being captured  hint       -> the idle line (keys from the bindings)
+ *   caphint              -> the capture line's tail
+ *   status               -> one complete footer line with the port labels (host tests, logs) */
+static int pad_kb_ui_command(PadKbUi* u, PadKeybinds* kb, const char* cmd, char* out, size_t n, unsigned long long now)
+{
+    char verb[16] = { 0 };
+    int r = -1, s = -1, in, k, ca = 0, cb = 0;
+    if (!n) return 0;
+    out[0] = 0;
+    if (sscanf(cmd, "%15s %d %d", verb, &r, &s) < 1) return 0;
+    if (!strcmp(verb, "padmap")) {
+        /* 4013: "padmap" -> the Controller layout value's name; "padmap <name>" sets it (1 = changed, saved). */
+        const char* v = cmd + 6;
+        int pv;
+        while (*v == ' ') v++;
+        if (!*v) { snprintf(out, n, "%s", prm_preset_names[kb->padmap < PRM_N_PRESETS ? kb->padmap : 0]); return 0; }
+        pv = prm_preset_by_name(v, strlen(v));
+        if (pv < 0) { snprintf(out, n, "bad"); return 0; }
+        snprintf(out, n, "%s", prm_preset_names[pv]);
+        if (kb->padmap == pv) return 0;
+        kb->padmap = (unsigned char)pv;
+        u->gen++;
+        return 1;
+    }
+    if (!strcmp(verb, "prompts")) {
+        /* 4011: "prompts" -> the Button prompts value's name; "prompts <name>" sets it (1 = changed, saved). */
+        const char* v = cmd + 7;
+        int pv;
+        while (*v == ' ') v++;
+        if (!*v) { snprintf(out, n, "%s", pkb_prompt_names[kb->prompts < PKB_N_PROMPTS ? kb->prompts : 0]); return 0; }
+        pv = pad_kb_prompts_by_name(v, strlen(v));
+        if (pv < 0) { snprintf(out, n, "bad"); return 0; }
+        snprintf(out, n, "%s", pkb_prompt_names[pv]);
+        if (kb->prompts == pv) return 0;
+        kb->prompts = (unsigned char)pv;
+        u->gen++;
+        return 1;
+    }
+    in = pad_kb_row_input(r);
+    if (!strcmp(verb, "rows")) { snprintf(out, n, "%d", PKB_N_ROWS); return 0; }
+    if (!strcmp(verb, "label")) { snprintf(out, n, "%s", in >= 0 ? pad_kb_rows[r].label : ""); return 0; }
+    if (!strcmp(verb, "src")) { snprintf(out, n, "%s", in >= 0 && pad_kb_rows[r].button ? pad_kb_rows[r].button : ""); return 0; }
+    if (!strcmp(verb, "key") || !strcmp(verb, "dup")) {
+        if (in < 0 || s < 0 || s >= PKB_SLOTS) { snprintf(out, n, verb[0] == 'k' ? "?" : ""); return 0; }
+        k = kb->key[in][s];
+        if (verb[0] == 'd') { snprintf(out, n, "%s", pad_kb_key_uses(kb, k) > 1 ? "1" : ""); return 0; }
+        if (u->phase != PKB_UI_IDLE && u->row == r && u->slot == s) { snprintf(out, n, "..."); return 0; }
+        snprintf(out, n, "%s", pad_kb_ui_keytext(k));
+        return 0;
+    }
+    if (!strcmp(verb, "capture")) {
+        if (in < 0 || s < 0 || s >= PKB_SLOTS) { snprintf(out, n, "bad"); return 0; }
+        u->phase = PKB_UI_RELEASE; u->row = r; u->slot = s; u->t0 = now; u->result = PKB_R_NONE; u->vk = 0;
+        u->gen++;                                           /* the row shows "..." */
+        snprintf(out, n, "ok");
+        return 0;
+    }
+    if (!strcmp(verb, "cancel")) {
+        u->sel = 0;
+        if (u->phase != PKB_UI_IDLE) { u->phase = PKB_UI_IDLE; u->suppress = 1; u->result = PKB_R_CANCEL; u->gen++; }
+        return 0;
+    }
+    if (!strcmp(verb, "sel")) {
+        u->sel = in >= 0 && s >= 0 && s < PKB_SLOTS ? r + 1 : 0;
+        u->sel_slot = u->sel ? s : 0;
+        return 0;
+    }
+    if (!strcmp(verb, "poll")) {
+        if (u->gen != u->seen_gen) { u->seen_gen = u->gen; snprintf(out, n, "changed"); }
+        else if (u->phase != PKB_UI_IDLE) snprintf(out, n, "busy");
+        return 0;
+    }
+    if (!strcmp(verb, "reset")) {
+        PadKeybinds keep = *kb;   /* 4011/4013: the Keyboard page's reset keeps the Button prompts and the pad layout */
+        pad_kb_defaults(kb); kb->prompts = keep.prompts; kb->padmap = keep.padmap; memcpy(kb->padc, keep.padc, sizeof kb->padc); u->phase = PKB_UI_IDLE; u->gen++; u->result = PKB_R_NONE;
+        snprintf(out, n, "ok");
+        return 1;
+    }
+    if (!strcmp(verb, "clear")) {
+        if (in < 0 || s < 0 || s >= PKB_SLOTS) { snprintf(out, n, "bad"); return 0; }
+        pad_kb_assign(kb, in, s, 0); u->gen++;
+        snprintf(out, n, "ok");
+        return 1;
+    }
+    k = pad_kb_first_conflict(kb, &ca, &cb);
+    if (!strcmp(verb, "state")) {
+        snprintf(out, n, "%s", u->phase != PKB_UI_IDLE ? "capture" : u->result == PKB_R_TIMEOUT ? "timeout" : k ? "conflict" : "idle");
+        return 0;
+    }
+    if (!strcmp(verb, "cf")) {
+        const char* w = strchr(cmd, ' ');
+        w = w ? w + 1 : "";
+        if (!k) return 0;
+        if (!strcmp(w, "key")) snprintf(out, n, "%s", pad_kb_key_short(k));
+        else if (!strcmp(w, "a")) snprintf(out, n, "%d", ca);
+        else if (!strcmp(w, "b")) snprintf(out, n, "%d", cb);
+        return 0;
+    }
+    if (!strcmp(verb, "cap")) { snprintf(out, n, "%d", u->phase != PKB_UI_IDLE ? u->row : -1); return 0; }
+    if (!strcmp(verb, "hint")) { pad_kb_ui_hint(kb, out, n); return 0; }
+    if (!strcmp(verb, "caphint")) { snprintf(out, n, "Esc cancels, Delete clears."); return 0; }
+    if (!strcmp(verb, "status")) {
+        if (u->phase != PKB_UI_IDLE)
+            snprintf(out, n, "Press a key for %s. Esc cancels, Delete clears.", pad_kb_rows[u->row].label);
+        else if (u->result == PKB_R_TIMEOUT) snprintf(out, n, "No key pressed: unchanged.");
+        else if (k) snprintf(out, n, "%s is bound to both %s and %s.", pad_kb_key_short(k), pad_kb_rows[ca].label, pad_kb_rows[cb].label);
+        else pad_kb_ui_hint(kb, out, n);
+        return 0;
+    }
+    snprintf(out, n, "unknown");
+    return 0;
+}
+
+#endif /* PAD_KEYBINDS_H */
