+/* KZ3 patch 1032 (diagnostic, opt-in): per-thread wait accounting. See kz3_wait_acct.h.
+ *
+ * Each host thread owns one record; only that thread writes its slots (no locks on the
+ * hot path), the printer thread reads them racily and prints differences against its own
+ * snapshot. A torn read can misplace one sample in one window; the totals stay right. */
+#include "kz3_wait_acct.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include <pthread.h>
+#  include <time.h>
+#  include <unistd.h>
+#endif
+
+int g_kz3_wacct = -1;
+/* KZ3 patch 1102: read by every computed-hop guess (spu_context.h SPU_READ_MOSTLY; this TU does not include it) */
+#if defined(_WIN32) && defined(__GNUC__) && !defined(SPU_NO_READ_MOSTLY)
+__attribute__((section(".data$kz3rm")))
+#endif
+void (*g_kz3_wtrace)(const char* thr, int kind, uint32_t site, uint64_t t0, uint64_t t1) = 0;   /* patch 1085 */
+
+enum { WA_SLOTS = 1024, WA_THREADS = 96 };
+typedef struct { volatile uint64_t key; volatile uint64_t ns; volatile uint64_t n; } wa_slot;
+typedef struct {
+    char name[40];
+    unsigned long ostid;
+    int depth;
+    volatile uint64_t top_ns[KZ3_WA_NKIND], top_n[KZ3_WA_NKIND];
+    int job_img; uint64_t job_t0;
+    void* hthr;   /* patch 1033: duplicated thread handle when the profiler samples this thread */
+    void* stk_hi; /* patch 7011: the sampled thread's stack base (NT_TIB.StackBase), for KZ2_PROF_STACK */
+    void* stk_lo; /* patch 7011: the low end of that stack's reservation */
+    wa_slot tab[WA_SLOTS];
+    /* printer-owned snapshot */
+    uint64_t p_ns[WA_SLOTS], p_n[WA_SLOTS], p_top_ns[KZ3_WA_NKIND], p_top_n[KZ3_WA_NKIND];
+} wa_thr;
+
+static wa_thr* s_thr[WA_THREADS];
+static volatile long s_nthr = 0;
+static volatile long s_flips = 0;
+static uint64_t s_t0;
+
+#ifdef _WIN32
+static DWORD s_tls = TLS_OUT_OF_INDEXES;
+static LARGE_INTEGER s_qf;
+uint64_t kz3_wacct_now(void)
+{
+    LARGE_INTEGER c; QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)s_qf.QuadPart);
+}
+static wa_thr* tls_get(void) { return (wa_thr*)TlsGetValue(s_tls); }
+static void tls_set(wa_thr* t) { TlsSetValue(s_tls, t); }
+static unsigned long os_tid(void) { return (unsigned long)GetCurrentThreadId(); }
+#else
+static __thread wa_thr* s_me;
+uint64_t kz3_wacct_now(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+static wa_thr* tls_get(void) { return s_me; }
+static void tls_set(wa_thr* t) { s_me = t; }
+static unsigned long os_tid(void) { return (unsigned long)pthread_self(); }
+#endif
+
+static wa_thr* me(void)
+{
+    wa_thr* t = tls_get();
+    if (t) return t;
+    long i = __sync_fetch_and_add(&s_nthr, 1);
+    if (i >= WA_THREADS) return NULL;
+    t = (wa_thr*)calloc(1, sizeof *t);
+    if (!t) return NULL;
+    t->ostid = os_tid();
+    s_thr[i] = t;
+    tls_set(t);
+    return t;
+}
+
+static wa_slot* slot(wa_thr* t, int kind, uint32_t site)
+{
+    uint64_t key = ((uint64_t)(kind + 1) << 32) | site;
+    uint32_t h = (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 54) & (WA_SLOTS - 1);
+    for (int p = 0; p < WA_SLOTS - 1; p++) {
+        wa_slot* s = &t->tab[(h + p) & (WA_SLOTS - 1)];
+        if (s->key == key) return s;
+        if (!s->key) { s->key = key; return s; }
+    }
+    return NULL;
+}
+
+static void add(wa_thr* t, int kind, uint32_t site, uint64_t ns, uint64_t n)
+{
+    wa_slot* s = slot(t, kind, site);
+    if (s) { s->ns += ns; s->n += n; }
+}
+
+uint64_t kz3_wacct_begin_slow(void)
+{
+    wa_thr* t = me();
+    if (!t) return 0;
+    t->depth++;
+    uint64_t v = kz3_wacct_now();
+    return v ? v : 1;
+}
+
+void kz3_wacct_end(int kind, uint32_t site, uint64_t t0)
+{
+    if (!t0) return;
+    wa_thr* t = tls_get();
+    if (!t) return;
+    const uint64_t t1 = kz3_wacct_now(), d = t1 - t0;
+    if (g_kz3_wtrace) g_kz3_wtrace(t->name, kind, site, t0, t1);   /* patch 1085 */
+    add(t, kind, site, d, 1);
+    if (--t->depth == 0) { t->top_ns[kind] += d; t->top_n[kind]++; }
+}
+
+void kz3_wacct_note(int kind, uint32_t site, uint64_t ns)
+{
+    if (!kz3_wacct_on()) return;
+    wa_thr* t = me();
+    if (t) add(t, kind, site, ns, 1);
+    if (t && g_kz3_wtrace) { const uint64_t n = kz3_wacct_now(); g_kz3_wtrace(t->name, kind, site, n - ns, n); }   /* 1085 */
+}
+
+/* patch 1085: one event for the trace hook (no accounting) */
+void kz3_wacct_trace(int kind, uint32_t site, uint64_t t0, uint64_t t1)
+{
+    if (!g_kz3_wtrace) return;
+    wa_thr* t = me();
+    if (t) g_kz3_wtrace(t->name, kind, site, t0, t1);
+}
+uint64_t kz3_wacct_base(void) { return s_t0; }
+
+void kz3_wacct_job(int image)
+{
+    if (!kz3_wacct_on()) return;
+    wa_thr* t = me();
+    if (t && g_kz3_wtrace) { const uint64_t n = kz3_wacct_now(); g_kz3_wtrace(t->name, KZ3_WA_JOB, (uint32_t)image, n, n); }   /* 1085 */
+    if (!t || t->job_img == image) return;
+    uint64_t now = kz3_wacct_now();
+    if (t->job_img) add(t, KZ3_WA_JOB, (uint32_t)t->job_img, now - t->job_t0, 0);
+    t->job_img = image; t->job_t0 = now;
+    if (image) add(t, KZ3_WA_JOB, (uint32_t)image, 0, 1);
+}
+
+static void prof_attach(wa_thr* t);   /* patch 1033 */
+
+/* Names this host thread. If a record of that name exists already, this thread takes
+ * it over: short-lived threads that run one after another (the per-pass policy-module
+ * workers) then share one record instead of using one each. The previous owner must
+ * be finished (true for the workers: the kernel joins them each pass). */
+void kz3_wacct_name(const char* name)
+{
+    if (!kz3_wacct_on()) return;
+    static volatile long lock = 0;
+    while (__sync_lock_test_and_set(&lock, 1)) { }
+    long nt = s_nthr; if (nt > WA_THREADS) nt = WA_THREADS;
+    for (long i = 0; i < nt; i++)
+        if (s_thr[i] && strncmp(s_thr[i]->name, name, sizeof s_thr[i]->name - 1) == 0) {
+            s_thr[i]->ostid = os_tid(); tls_set(s_thr[i]);
+            prof_attach(s_thr[i]);
+            __sync_lock_release(&lock);
+            return;
+        }
+    wa_thr* t = tls_get();
+    if (!t) t = me();
+    if (t) { strncpy(t->name, name, sizeof t->name - 1); prof_attach(t); }
+    __sync_lock_release(&lock);
+}
+
+void kz3_wacct_flip(void)
+{
+    if (g_kz3_wacct > 0) __sync_fetch_and_add(&s_flips, 1);
+    if (g_kz3_wtrace) { const uint64_t n = kz3_wacct_now(); kz3_wacct_trace(KZ3_WT_FLIP, 0, n, n); }   /* patch 1085 */
+}
+
+/* ---- names ---------------------------------------------------------------------- */
+/* Set by ppu_hle.cpp when it registers its first import: programs that link the runtime without the HLE
+ * module (native unit tests, host smoke tests) leave it NULL and print NIDs. */
+const char* (*g_kz3_wacct_hle_name)(uint32_t nid) = 0;
+#ifdef _WIN32
+const char* ppu_thread_name_for_os_tid(unsigned long os_tid);   /* sys_ppu_thread.c */
+#endif
+
+static const char* sc_name(uint32_t n)
+{
+    switch (n) {
+    case 43: return "ppu_thread_yield";  case 44: return "ppu_thread_join";
+    case 85: return "event_flag_wait";   case 87: return "event_flag_set";
+    case 92: return "semaphore_wait";    case 94: return "semaphore_post";
+    case 97: return "lwmutex_lock";      case 98: return "lwmutex_unlock";
+    case 102: return "mutex_lock";       case 104: return "mutex_unlock";
+    case 107: return "cond_wait";        case 108: return "cond_signal";
+    case 113: return "lwcond_queue_wait";
+    case 130: return "event_queue_receive"; case 134: return "event_port_send";
+    case 138: return "event_port_send";  case 141: return "timer_usleep";
+    case 142: return "timer_sleep";
+    default: return NULL;
+    }
+}
+
+static const char* kind_name[KZ3_WA_NKIND] = {
+    "hle", "sc", "usleep", "label", "ksleep", "pmrun", "job", "kgap", "kskip", "park" };
+
+static void site_str(int kind, uint32_t site, char* o, size_t n)
+{
+    const char* nm = NULL;
+    switch (kind) {
+    case KZ3_WA_HLE:
+        if (g_kz3_wacct_hle_name) nm = g_kz3_wacct_hle_name(site);
+        if (nm) snprintf(o, n, "%s", nm); else snprintf(o, n, "nid%08X", site);
+        return;
+    case KZ3_WA_SC:
+        nm = sc_name(site);
+        if (nm) snprintf(o, n, "%s", nm); else snprintf(o, n, "sc%u", site);
+        return;
+    case KZ3_WA_USLEEP: snprintf(o, n, "lr%08X", site); return;
+    case KZ3_WA_LABEL:  snprintf(o, n, "label%u", site); return;
+    case KZ3_WA_PMRUN: case KZ3_WA_KGAP: case KZ3_WA_KSKIP: snprintf(o, n, "wid%u", site); return;
+    case KZ3_WA_JOB:    snprintf(o, n, "ovl%u", site); return;
+    default:            snprintf(o, n, "%u", site); return;
+    }
+}
+
+static void thr_name(wa_thr* t, char* o, size_t n)
+{
+    if (t->name[0]) { snprintf(o, n, "%s", t->name); return; }
+#ifdef _WIN32
+    const char* g = ppu_thread_name_for_os_tid(t->ostid);
+    if (g && *g) { snprintf(o, n, "ppu:%s", g); return; }
+#endif
+    snprintf(o, n, "host%lu", t->ostid);
+}
+
+/* ---- printer ---------------------------------------------------------------------- */
+static void print_window(double t_s, long flips)
+{
+    fprintf(stderr, "[wacct] ---- t=%.1fs window=%dms flips=%ld\n", t_s, g_kz3_wacct, flips);
+    long nt = s_nthr; if (nt > WA_THREADS) nt = WA_THREADS;
+    for (long i = 0; i < nt; i++) {
+        wa_thr* t = s_thr[i];
+        if (!t) continue;
+        uint64_t dtop[KZ3_WA_NKIND], dtopn[KZ3_WA_NKIND], tot = 0;
+        for (int k = 0; k < KZ3_WA_NKIND; k++) {
+            uint64_t a = t->top_ns[k], b = t->top_n[k];
+            dtop[k] = a - t->p_top_ns[k]; dtopn[k] = b - t->p_top_n[k];
+            t->p_top_ns[k] = a; t->p_top_n[k] = b; tot += dtop[k];
+        }
+        /* KZ2 patch 7006: KZ2_WACCT_TOPN=N lists the N costliest sites per thread (4..48, default 12), so short jobs
+         * (the Gfx.Post chain's) stay in the job:ovlN lists. */
+        enum { TOPN_MAX = 48 };
+        static int s_topn;
+        if (!s_topn) {
+            const char* e = getenv("KZ2_WACCT_TOPN");
+            const int v = e ? atoi(e) : 12;
+            s_topn = v < 4 ? 4 : v > TOPN_MAX ? TOPN_MAX : v;
+        }
+        const int TOPN = s_topn;
+        int best[TOPN_MAX]; uint64_t bns[TOPN_MAX], bn[TOPN_MAX]; int nb = 0;
+        uint64_t any = 0, skips = 0;
+        uint32_t gs[6]; uint64_t gns[6], gn[6]; int ng = 0;
+        for (int s = 0; s < WA_SLOTS; s++) {
+            uint64_t key = t->tab[s].key;
+            if (!key) continue;
+            uint64_t a = t->tab[s].ns, b = t->tab[s].n;
+            uint64_t dn = a - t->p_ns[s], dc = b - t->p_n[s];
+            t->p_ns[s] = a; t->p_n[s] = b;
+            if (!dn && !dc) continue;
+            any += dn + dc;
+            if ((int)(key >> 32) - 1 == KZ3_WA_KSKIP) { skips += dc; continue; }
+            if ((int)(key >> 32) - 1 == KZ3_WA_KGAP) {   /* gaps: own field, by count */
+                if (ng < 6) { gs[ng] = (uint32_t)key; gns[ng] = dn; gn[ng] = dc; ng++; }
+                else { int lo = 0; for (int q = 1; q < 6; q++) if (gn[q] < gn[lo]) lo = q;
+                       if (dc > gn[lo]) { gs[lo] = (uint32_t)key; gns[lo] = dn; gn[lo] = dc; } }
+                continue;
+            }
+            /* insertion into the top list by ns (count as tie-break) */
+            int pos = nb;
+            while (pos > 0 && (bns[pos - 1] < dn || (bns[pos - 1] == dn && bn[pos - 1] < dc))) pos--;
+            if (pos >= TOPN) continue;
+            int last = nb < TOPN ? nb : TOPN - 1;
+            for (int q = last; q > pos; q--) { best[q] = best[q - 1]; bns[q] = bns[q - 1]; bn[q] = bn[q - 1]; }
+            best[pos] = s; bns[pos] = dn; bn[pos] = dc;
+            if (nb < TOPN) nb++;
+        }
+        if (!any && !tot) continue;
+        char nm[64], line[2000]; int o = 0;
+        thr_name(t, nm, sizeof nm);
+        o += snprintf(line + o, sizeof line - o, "[wacct] thr=%s wait=%llums", nm, (unsigned long long)(tot / 1000000ull));
+        for (int k = 0; k < KZ3_WA_NKIND; k++)
+            if (dtop[k] >= 500000ull || (dtopn[k] && k == KZ3_WA_PMRUN))
+                o += snprintf(line + o, sizeof line - o, " %s=%llu/%llu", kind_name[k],
+                              (unsigned long long)(dtop[k] / 1000000ull), (unsigned long long)dtopn[k]);
+        if (skips) o += snprintf(line + o, sizeof line - o, " kskip=%llu", (unsigned long long)skips);
+        for (int g = 0; g < ng; g++)
+            o += snprintf(line + o, sizeof line - o, " gap:wid%u=%.1fms*%llu", gs[g],
+                          gn[g] ? (double)gns[g] / 1e6 / (double)gn[g] : 0.0, (unsigned long long)gn[g]);
+        o += snprintf(line + o, sizeof line - o, " |");
+        for (int b = 0; b < nb && o < (int)sizeof line - 80; b++) {
+            uint64_t key = t->tab[best[b]].key;
+            int kind = (int)(key >> 32) - 1; char st[48];
+            site_str(kind, (uint32_t)key, st, sizeof st);
+            o += snprintf(line + o, sizeof line - o, " %s:%s=%.1fms/%llu", kind_name[kind], st,
+                          (double)bns[b] / 1e6, (unsigned long long)bn[b]);
+        }
+        fprintf(stderr, "%s\n", line);
+    }
+    fflush(stderr);
+}
+
+#ifdef _WIN32
+static DWORD WINAPI printer(LPVOID p)
+#else
+static void* printer(void* p)
+#endif
+{
+    (void)p;
+    long last_flips = 0;
+    for (;;) {
+#ifdef _WIN32
+        Sleep((DWORD)g_kz3_wacct);
+#else
+        usleep((useconds_t)g_kz3_wacct * 1000u);
+#endif
+        long f = s_flips;
+        print_window((double)(kz3_wacct_now() - s_t0) / 1e9, f - last_flips);
+        last_flips = f;
+    }
+    return 0;
+}
+
+
+/* ---- KZ3 patch 1033: host sampling profiler (Windows only, needs KZ3_WAIT_ACCT) ------------------
+ * KZ3_PROF=FROM,TO (seconds since start): from FROM to TO a sampler thread suspends every profiled
+ * thread about once per ms, reads its RIP and counts (RIP, resident job module) pairs; at TO it prints
+ * every pair once ("[prof] rva=0x... job=N n=..."; rva relative to the exe's load address, "ext" for
+ * code outside the exe) and stops. tools/spu/prof_resolve.py maps the RVAs to function names.
+ * Profiled threads: those named through kz3_wacct_name whose name contains KZ3_PROF_FILTER (patch 1079: one of its |-separated parts;
+ * the main PPU thread is "ppu-main")
+ * (default: the SPURS kernel threads "spurs-kern" and the lane workers "pm-worker"). */
+#ifdef _WIN32
+enum { PR_SLOTS = 1 << 16 };
+typedef struct { uint64_t rip; int job; uint32_t n; } pr_ent;
+static pr_ent* s_pr;
+static volatile long s_pr_lock = 0;
+static int s_prof_on = -1;
+static double s_prof_from = 0, s_prof_to = 0;
+static const char* s_prof_filter = 0;
+
+static void pr_add(uint64_t rip, int job)
+{
+    uint64_t key = rip ^ ((uint64_t)(uint32_t)job << 40);
+    uint32_t h = (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 40) & (PR_SLOTS - 1);
+    for (int p = 0; p < 64; p++) {
+        pr_ent* e = &s_pr[(h + p) & (PR_SLOTS - 1)];
+        if (e->n && e->rip == rip && e->job == job) { e->n++; return; }
+        if (!e->n) { e->rip = rip; e->job = job; e->n = 1; return; }
+    }
+}
+
+/* ---- KZ2 patch 7011: caller chains for profiler samples outside the exe (KZ2_PROF_STACK=1, off by default) ----
+ * A sample whose RIP lies outside the exe (a thread blocked in a system call sits in ntdll) says nothing about who
+ * waits. With KZ2_PROF_STACK=1 the sampler also scans the suspended thread's stack upwards from RSP (no unwinder,
+ * no lock: only reads of that stack and of loaded images) for return addresses: values inside a module listed at
+ * the first sample (Toolhelp) that follow a call instruction (E8 rel32, FF /2 with a disp32, disp8 or register
+ * operand). It keeps the first KZ2_PS_DEPTH such frames (stopping after the second one inside the exe) per
+ * (RIP, job) and prints at the end "[prof-stack] job=N n=COUNT rip=WHERE f0=WHERE f1=..." for chains seen at least
+ * KZ2_PROF_STACK_MIN times (default 20), WHERE being exe+0xRVA (resolve with nm, like [prof] rva=) or
+ * module+0xOFF(export+0xOFF) (the nearest export at or below). A heuristic: a stale return address left on the
+ * stack can appear as a frame; chains are counted, so a stale value shows as a minority chain. */
+#include <tlhelp32.h>
+enum { PS_SLOTS = 1 << 14, KZ2_PS_DEPTH = 8, PS_MODS = 256 };
+typedef struct { uint64_t rip; uint64_t f[KZ2_PS_DEPTH]; int job; uint32_t n; } ps_ent;
+static ps_ent* s_ps;
+static int s_ps_on = 0;
+static struct { uint64_t lo, hi; char name[48]; } s_mods[PS_MODS];
+static int s_nmods = -1;
+
+static void ps_load_mods(void)
+{
+    s_nmods = 0;
+    HANDLE sn = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE, 0);
+    if (sn == INVALID_HANDLE_VALUE) return;
+    MODULEENTRY32 me; me.dwSize = sizeof me;
+    if (Module32First(sn, &me)) do {
+        s_mods[s_nmods].lo = (uint64_t)(uintptr_t)me.modBaseAddr;
+        s_mods[s_nmods].hi = s_mods[s_nmods].lo + me.modBaseSize;
+        strncpy(s_mods[s_nmods].name, me.szModule, sizeof s_mods[0].name - 1);
+        s_nmods++;
+    } while (s_nmods < PS_MODS && Module32Next(sn, &me));
+    CloseHandle(sn);
+}
+
+static int ps_mod(uint64_t v)
+{
+    for (int i = 0; i < s_nmods; i++)
+        if (v >= s_mods[i].lo + 0x1000 && v < s_mods[i].hi) return i;
+    return -1;
+}
+
+static int ps_is_ret(uint64_t v)
+{
+    if (ps_mod(v) < 0) return 0;
+    const uint8_t* p = (const uint8_t*)(uintptr_t)v;
+    if (p[-5] == 0xE8) return 1;                                                     /* call rel32 */
+    if (p[-6] == 0xFF && ((p[-5] >> 3) & 7) == 2 && (p[-5] >> 6) != 1 && (p[-5] >> 6) != 3) return 1; /* [rip+d32] */
+    if (p[-7] == 0xFF && ((p[-6] >> 3) & 7) == 2 && (p[-6] >> 6) == 2) return 1;   /* [r+sib+d32] */
+    if (p[-3] == 0xFF && ((p[-2] >> 3) & 7) == 2 && (p[-2] >> 6) == 1) return 1;   /* [r+d8] */
+    if (p[-4] == 0xFF && ((p[-3] >> 3) & 7) == 2 && (p[-3] >> 6) == 1) return 1;   /* [r+sib+d8] */
+    if (p[-2] == 0xFF && ((p[-1] >> 3) & 7) == 2 && (p[-1] >> 6) == 3) return 1;   /* call reg */
+    if (p[-3] == 0x41 && p[-2] == 0xFF && ((p[-1] >> 3) & 7) == 2 && (p[-1] >> 6) == 3) return 1;
+    if (p[-2] == 0xFF && ((p[-1] >> 3) & 7) == 2 && (p[-1] >> 6) == 0) return 1;   /* call [reg] */
+    return 0;
+}
+
+static void ps_sample(uint64_t rip, uint64_t rsp, const void* stk_lo, const void* stk_hi, int job, uint64_t base,
+                      uint64_t size)
+{
+    if (s_nmods < 0) ps_load_mods();
+    /* only a RSP inside the thread's own stack reservation: from RSP up to the base the pages are in use */
+    if (!stk_hi || !stk_lo || rsp < (uint64_t)(uintptr_t)stk_lo || rsp >= (uint64_t)(uintptr_t)stk_hi) return;
+    uint64_t f[KZ2_PS_DEPTH]; memset(f, 0, sizeof f);
+    const uint64_t* sp = (const uint64_t*)(uintptr_t)(rsp & ~7ull);
+    const uint64_t* hi = (const uint64_t*)stk_hi;
+    int nf = 0, nexe = 0;
+    for (int k = 0; k < 8192 && sp + k < hi && nf < KZ2_PS_DEPTH; k++) {
+        const uint64_t v = sp[k];
+        if (!ps_is_ret(v)) continue;
+        f[nf++] = v;
+        if (v >= base && v < base + size && ++nexe >= 2) break;
+    }
+    uint64_t key = rip ^ ((uint64_t)(uint32_t)job << 40);
+    for (int i = 0; i < KZ2_PS_DEPTH; i++) key = (key ^ f[i]) * 0x100000001B3ull;
+    const uint32_t h = (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 40) & (PS_SLOTS - 1);
+    for (int p = 0; p < 64; p++) {
+        ps_ent* e = &s_ps[(h + p) & (PS_SLOTS - 1)];
+        if (e->n && e->rip == rip && e->job == job && memcmp(e->f, f, sizeof f) == 0) { e->n++; return; }
+        if (!e->n) { e->rip = rip; e->job = job; memcpy(e->f, f, sizeof f); e->n = 1; return; }
+    }
+}
+
+static void ps_where(char* out, size_t cap, uint64_t v, uint64_t base, uint64_t size)
+{
+    if (v >= base && v < base + size) { snprintf(out, cap, "exe+0x%llx", (unsigned long long)(v - base)); return; }
+    int m = -1;
+    for (int i = 0; i < s_nmods; i++) if (v >= s_mods[i].lo && v < s_mods[i].hi) { m = i; break; }
+    if (m < 0) { snprintf(out, cap, "0x%llx", (unsigned long long)v); return; }
+    const uint64_t lo = s_mods[m].lo;
+    const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(uintptr_t)(lo + ((const IMAGE_DOS_HEADER*)(uintptr_t)lo)->e_lfanew);
+    const IMAGE_DATA_DIRECTORY* dd = &nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+    const char* best = NULL; uint32_t best_rva = 0;
+    const uint32_t rva = (uint32_t)(v - lo);
+    if (dd->VirtualAddress && dd->Size) {
+        const IMAGE_EXPORT_DIRECTORY* ed = (const IMAGE_EXPORT_DIRECTORY*)(uintptr_t)(lo + dd->VirtualAddress);
+        const uint32_t* fn = (const uint32_t*)(uintptr_t)(lo + ed->AddressOfFunctions);
+        const uint32_t* nm = (const uint32_t*)(uintptr_t)(lo + ed->AddressOfNames);
+        const uint16_t* ord = (const uint16_t*)(uintptr_t)(lo + ed->AddressOfNameOrdinals);
+        for (uint32_t i = 0; i < ed->NumberOfNames; i++) {
+            const uint32_t r = fn[ord[i]];
+            if (r <= rva && r >= best_rva && !(r >= dd->VirtualAddress && r < dd->VirtualAddress + dd->Size)) {
+                best_rva = r; best = (const char*)(uintptr_t)(lo + nm[i]);
+            }
+        }
+    }
+    if (best) snprintf(out, cap, "%s+0x%x(%s+0x%x)", s_mods[m].name, rva, best, rva - best_rva);
+    else snprintf(out, cap, "%s+0x%x", s_mods[m].name, rva);
+}
+
+static void ps_print(uint64_t base, uint64_t size)
+{
+    const char* e = getenv("KZ2_PROF_STACK_MIN");
+    const uint32_t min = e ? (uint32_t)atoi(e) : 20u;
+    char w[KZ2_PS_DEPTH + 1][160];
+    for (int i = 0; i < PS_SLOTS; i++) {
+        const ps_ent* p = &s_ps[i];
+        if (!p->n || p->n < min) continue;
+        ps_where(w[0], sizeof w[0], p->rip, base, size);
+        int n = 0;
+        while (n < KZ2_PS_DEPTH && p->f[n]) { ps_where(w[n + 1], sizeof w[0], p->f[n], base, size); n++; }
+        fprintf(stderr, "[prof-stack] job=%d n=%u rip=%s", p->job, p->n, w[0]);
+        for (int k = 0; k < n; k++) fprintf(stderr, " f%d=%s", k, w[k + 1]);
+        fputc('\n', stderr);
+    }
+}
+
+static DWORD WINAPI prof_thread(LPVOID p)
+{
+    (void)p;
+    const uint64_t base = (uint64_t)(uintptr_t)GetModuleHandleA(NULL);
+    const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(uintptr_t)(base + ((const IMAGE_DOS_HEADER*)(uintptr_t)base)->e_lfanew);
+    const uint64_t size = nt->OptionalHeader.SizeOfImage;
+    uint64_t samples = 0, miss = 0;
+    for (;;) {
+        Sleep(1);
+        double t = (double)(kz3_wacct_now() - s_t0) / 1e9;
+        if (t < s_prof_from) continue;
+        if (t >= s_prof_to) break;
+        while (__sync_lock_test_and_set(&s_pr_lock, 1)) { }
+        long nt2 = s_nthr; if (nt2 > WA_THREADS) nt2 = WA_THREADS;
+        for (long i = 0; i < nt2; i++) {
+            wa_thr* w = s_thr[i];
+            if (!w || !w->hthr) continue;
+            HANDLE h = (HANDLE)w->hthr;
+            if (SuspendThread(h) == (DWORD)-1) { miss++; continue; }
+            CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_CONTROL;
+            if (GetThreadContext(h, &c)) {
+                pr_add((uint64_t)c.Rip, w->job_img); samples++;
+                if (s_ps_on && !((uint64_t)c.Rip >= base && (uint64_t)c.Rip < base + size))   /* patch 7011 */
+                    ps_sample((uint64_t)c.Rip, (uint64_t)c.Rsp, w->stk_lo, w->stk_hi, w->job_img, base, size);
+            } else miss++;
+            ResumeThread(h);
+        }
+        __sync_lock_release(&s_pr_lock);
+    }
+    fprintf(stderr, "[prof] done t=%.1f..%.1fs samples=%llu miss=%llu base=0x%llx size=0x%llx\n", s_prof_from, s_prof_to,
+            (unsigned long long)samples, (unsigned long long)miss, (unsigned long long)base, (unsigned long long)size);
+    for (int i = 0; i < PR_SLOTS; i++) {
+        const pr_ent* e = &s_pr[i];
+        if (!e->n) continue;
+        if (e->rip >= base && e->rip < base + size)
+            fprintf(stderr, "[prof] rva=0x%llx job=%d n=%u\n", (unsigned long long)(e->rip - base), e->job, e->n);
+        else
+            fprintf(stderr, "[prof] ext=0x%llx job=%d n=%u\n", (unsigned long long)e->rip, e->job, e->n);
+    }
+    if (s_ps_on) ps_print(base, size);   /* patch 7011 */
+    fflush(stderr);
+    return 0;
+}
+
+static void prof_init(void)
+{
+    const char* e = getenv("KZ3_PROF");
+    s_prof_on = 0;
+    if (!e || sscanf(e, "%lf,%lf", &s_prof_from, &s_prof_to) != 2 || s_prof_to <= s_prof_from) return;
+    s_prof_filter = getenv("KZ3_PROF_FILTER");
+    s_pr = (pr_ent*)calloc(PR_SLOTS, sizeof *s_pr);
+    if (!s_pr) return;
+    s_prof_on = 1;
+    {   /* patch 7011 */
+        const char* ps = getenv("KZ2_PROF_STACK");
+        if (ps && atoi(ps) > 0 && (s_ps = (ps_ent*)calloc(PS_SLOTS, sizeof *s_ps)) != NULL) {
+            s_ps_on = 1;
+            fprintf(stderr, "[prof-stack] on: caller chains of samples outside the exe (KZ2 patch 7011)\n");
+        }
+    }
+    fprintf(stderr, "[prof] on: %.0f..%.0f s, threads matching %s (KZ3 patch 1033)\n", s_prof_from, s_prof_to,
+            s_prof_filter ? s_prof_filter : "spurs-kern|pm-worker");
+    CreateThread(NULL, 1u << 18, prof_thread, NULL, 0, NULL);
+}
+
+/* patch 1079: KZ3_PROF_FILTER is a '|'-separated list of substrings (e.g. "ppu-main|spurs-kern"); a thread is
+ * profiled when its name contains any of them. */
+static int prof_match(const char* name, const char* filter)
+{
+    for (const char* f = filter; *f;) {
+        const char* bar = strchr(f, '|');
+        const size_t n = bar ? (size_t)(bar - f) : strlen(f);
+        if (n) {
+            for (const char* p = name; *p; p++)
+                if (strncmp(p, f, n) == 0) return 1;
+        }
+        if (!bar) break;
+        f = bar + 1;
+    }
+    return 0;
+}
+
+static void prof_attach(wa_thr* t)
+{
+    if (s_prof_on <= 0 || !t) return;
+    if (!prof_match(t->name, s_prof_filter ? s_prof_filter : "spurs-kern|pm-worker")) return;
+    HANDLE h = NULL;
+    if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h,
+                         THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0)) return;
+    while (__sync_lock_test_and_set(&s_pr_lock, 1)) { }
+    if (t->hthr) CloseHandle((HANDLE)t->hthr);
+    t->hthr = h;
+    t->stk_hi = ((NT_TIB*)NtCurrentTeb())->StackBase;   /* patch 7011: prof_attach runs on the thread itself */
+    {
+        MEMORY_BASIC_INFORMATION mb;
+        t->stk_lo = VirtualQuery(&mb, &mb, sizeof mb) ? mb.AllocationBase : NULL;
+    }
+    __sync_lock_release(&s_pr_lock);
+}
+#else
+static void prof_init(void) { }
+static void prof_attach(wa_thr* t) { (void)t; }
+#endif
+
+int kz3_wacct_init(void)
+{
+    static volatile long once = 0;
+    if (__sync_val_compare_and_swap(&once, 0, 1) != 0) {
+        while (*(volatile int*)&g_kz3_wacct < 0) { /* another thread is initialising */ }
+        return g_kz3_wacct;
+    }
+    const char* e = getenv("KZ3_WAIT_ACCT");
+    int ms = e ? atoi(e) : 0;
+    if (ms < 0) ms = 0;
+    if (ms > 0 && ms < 100) ms = 1000;   /* KZ3_WAIT_ACCT=1 means "on, 1 s windows" */
+#ifdef _WIN32
+    QueryPerformanceFrequency(&s_qf);
+    if (ms) { s_tls = TlsAlloc(); if (s_tls == TLS_OUT_OF_INDEXES) ms = 0; }
+#endif
+    s_t0 = kz3_wacct_now();
+    if (ms) {
+        fprintf(stderr, "[wacct] on: %d ms windows (KZ3 patch 1032)\n", ms);
+        g_kz3_wacct = ms;
+        prof_init();   /* patch 1033 */
+#ifdef _WIN32
+        CreateThread(NULL, 1u << 18, printer, NULL, 0, NULL);
+#else
+        pthread_t th; pthread_create(&th, NULL, printer, NULL);
+#endif
+    } else g_kz3_wacct = 0;
+    return g_kz3_wacct;
+}
