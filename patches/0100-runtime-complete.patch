-
-def w4(*w):
-    return list(w) + [w[-1]] * (4 - len(w))
-
-
-def d2(a, b=None):
-    b = a if b is None else b
-    return [a >> 32, a & 0xFFFFFFFF, b >> 32, b & 0xFFFFFFFF]
