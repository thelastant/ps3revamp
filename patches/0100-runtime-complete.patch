+/* A PUTLLC landed in the first 0x1900 bytes of a taskset the runtime tracks (bitsets, task_info): SPU code
+ * may have created a task or made one ready (KZ3's Havok task calls the SPU-side cellSpursCreateTask2,
+ * elf_00f6b900 LS 0x1C710, then joins it). The real taskset policy module would schedule it; scan the
+ * taskset now, as a task exit does, instead of only when some task of it exits (KZ3 patch 1022; named
+ * _scan since upstream's spu_taskset_line_committed below wakes WAIT_SIGNAL waiters on the same commits). */
+void spu_taskset_line_scan(uint32_t line)
+{
+    uint32_t hit = 0;
+    for (int i = 0; i < TS_TRACK; i++) {
+        uint32_t ts = s_ts_run[i].ea;
+        if (ts && line >= ts && line < ts + 0x1900u) { hit = ts; break; }
+    }
+    if (hit) {
+        /* TS_SCAN_LOG=1: what the SPU changed and what the scan sees (KZ3 patch 1023, diagnostic). */
+        static int s_lg = -1; if (s_lg < 0) s_lg = getenv("TS_SCAN_LOG") ? 1 : 0;
+        if (s_lg) {
+            static volatile LONG n; LONG k = InterlockedIncrement(&n);
+            if (k <= 200 || (k % 4096) == 0) {
+                extern uint8_t* vm_base; const uint8_t* t = vm_base + hit;
+                uint8_t* run = ts_running(hit);
+                fprintf(stderr, "[ts-scan] #%ld putllc ts=0x%08X +0x%04X run=%02X%02X ready=%02X%02X pend=%02X%02X en=%02X%02X sig=%02X%02X wait=%02X%02X\n",
+                        (long)k, hit, line - hit, run ? run[0] : 0, run ? run[1] : 0, t[0x10], t[0x11], t[0x20], t[0x21],
+                        t[0x30], t[0x31], t[0x40], t[0x41], t[0x50], t[0x51]);
+                for (int i = 0; i < 16; i++) {
+                    if (!(t[0x30 + i / 8] & (0x80u >> (i & 7)))) continue;
+                    const uint8_t* ti = t + 0x80 + 0x30 * i;
+                    fprintf(stderr, "[ts-scan]   task %d elf=%02X%02X%02X%02X ctx=%02X%02X%02X%02X\n", i, ti[0x14], ti[0x15], ti[0x16],
+                            ti[0x17], ti[0x1C], ti[0x1D], ti[0x1E], ti[0x1F]);
+                }
+            }
+        }
+        spu_taskset_task_exited(hit, 128u, 0);
+    }
+}
