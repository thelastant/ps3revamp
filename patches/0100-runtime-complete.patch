-
-SP_OPS = {"fa", "fs", "fm", "fma", "fms", "fnms", "frest", "frsqest", "fi", "fcgt", "fcmgt",
-          "fceq", "fcmeq", "cflts", "cfltu", "fesd"}
-DP_OPS = {"dfa", "dfs", "dfm", "dfma", "dfms", "dfnms", "dfnma", "frds"}
-INT_TO_F = {"csflt", "cuflt"}
