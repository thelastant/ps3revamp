-SPU__SF_V2(spu__fm_s, spu__fm_any(x, y))
-SPU__SF_V3(spu__fma_s,  spu__fma_any(x, y, z, 0, 0))
-SPU__SF_V3(spu__fms_s,  spu__fma_any(x, y, z, 0, 0x80000000u))
