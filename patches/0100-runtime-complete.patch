+            pc_draw(img, w, h, pc_d_poly, tri, 0.9f, S, (int)tx - 10, (int)ty - 10, (int)tx + 11, (int)ty + 9);
+            pc_rbox(img, w, h, L.sqr[0], L.sqr[1], 5.5f, 5.5f, 0.5f, 0.9f, S);
+            pc_ring(img, w, h, L.cir[0], L.cir[1], 6.f, 0.9f, S);
+            const float c1[1 + 4] = { 2.f, L.crs[0] - 5.5f, L.crs[1] - 5.5f, L.crs[0] + 5.5f, L.crs[1] + 5.5f };
+            const float c2[1 + 4] = { 2.f, L.crs[0] + 5.5f, L.crs[1] - 5.5f, L.crs[0] - 5.5f, L.crs[1] + 5.5f };
+            pc_draw(img, w, h, pc_d_poly, c1, 0.9f, S, (int)L.crs[0] - 9, (int)L.crs[1] - 9, (int)L.crs[0] + 10, (int)L.crs[1] + 10);
+            pc_draw(img, w, h, pc_d_poly, c2, 0.9f, S, (int)L.crs[0] - 9, (int)L.crs[1] - 9, (int)L.crs[0] + 10, (int)L.crs[1] + 10);
+        }
+        sel_y = 112.f;
+    }
+    pc_lead lead[PCL_N];
+    pc_leads(&L, sel_x, sel_y, lead);
+    for (int i = 0; i < PCL_N; i++) pc_line(img, w, h, lead[i].p, lead[i].n, W);
