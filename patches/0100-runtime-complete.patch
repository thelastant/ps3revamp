+static void pad_poll_sdl(void)
+{
+    unsigned long long now = pad_now_ms();
+    PSDL(SDL_LockMutex)(s_sdl_lock);
+    PSDL(SDL_UpdateGamepads)();
+    pad_sdl_sync(now);
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) {
+        PadSdlGamepad* gc = s_sdl_controllers[p];
+        if (!gc) { s_host_state[p].connected = 0; s_port_dev[p] = PAD_DEV_NONE; s_port_motion[p] = 0; continue; }
+        PadSdlRaw r;
+        for (int b = 0; b < PAD_SDL_BUTTON_MAX; b++)
+            r.button[b] = PSDL(SDL_GetGamepadButton)(gc, b) ? 1 : 0;
+        for (int a = 0; a < PAD_SDL_AXIS_MAX; a++)
+            r.axis[a] = PSDL(SDL_GetGamepadAxis)(gc, a);
+        pad_sdl_map(&r, &s_host_state[p]);
+        pad_sdl_sensor_recheck(p, gc, now);
+        s_port_motion[p] = s_sdl_sensors[p].on ? 1 : 0;   /* 4011 */
+        if (s_sdl_sensors[p].on) {
+            float acc[3], gyr[3];
+            int ha = (s_sdl_sensors[p].on & 1) && PSDL(SDL_GetGamepadSensorData)(gc, PAD_SDL_SENSOR_ACCEL, acc, 3);
+            int hg = (s_sdl_sensors[p].on & 2) && PSDL(SDL_GetGamepadSensorData)(gc, PAD_SDL_SENSOR_GYRO, gyr, 3);
+            pad_sdl_sensors(ha ? acc : NULL, hg ? gyr : NULL, &s_host_state[p]);
+        }
+        /* DualShock 3 analog button pressures (pad_host.h pad_sdl_press); other pads keep the digital 0/255. */
+        if (s_port_ps3_press[p]) {
+            PadSdlJoystick* js = PSDL(SDL_GetGamepadJoystick)(gc);
+            short ax[PAD_SDL_PS3_PRESS_COUNT];
+            for (int k = 0; k < PAD_SDL_PS3_PRESS_COUNT; k++)
+                ax[k] = js ? PSDL(SDL_GetJoystickAxis)(js, PAD_SDL_PS3_PRESS_FIRST + k) : -32768;
+            pad_sdl_press(ax, &s_host_state[p]);
+        }
+        if (PSDL(SDL_GetGamepadType)(gc) == PAD_SDL_TYPE_PS3 && s_sdl_sensors[p].on) pad_sdl_sensors_ds3_centre(&s_host_state[p]);
+        if ((s_rumble_lo[p] || s_rumble_hi[p]) && now - s_rumble_ms[p] >= PAD_SDL_REFRESH_MS) {
+            PSDL(SDL_RumbleGamepad)(gc, s_rumble_lo[p], s_rumble_hi[p], PAD_SDL_RUMBLE_MS);
+            s_rumble_ms[p] = now;
+        }
+    }
+    PSDL(SDL_UnlockMutex)(s_sdl_lock);
+}
+
+static void pad_sdl_rumble(u32 port_no, const u8 motor[CELL_PAD_ACTUATOR_MAX])
+{
+    unsigned short lo, hi;
+    pad_act_to_rumble(motor, &lo, &hi);
+    PSDL(SDL_LockMutex)(s_sdl_lock);
+    PadSdlGamepad* gc = s_sdl_controllers[port_no];
+    if (gc && (lo != s_rumble_lo[port_no] || hi != s_rumble_hi[port_no])) {
+        PSDL(SDL_RumbleGamepad)(gc, lo, hi, PAD_SDL_RUMBLE_MS);
+        s_rumble_lo[port_no] = lo; s_rumble_hi[port_no] = hi;
+        s_rumble_ms[port_no] = pad_now_ms();
+    }
+    PSDL(SDL_UnlockMutex)(s_sdl_lock);
+}
