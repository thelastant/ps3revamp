+static int pad_kb_prompts_by_name(const char* s, size_t n)
+{
+    size_t i, k;
+    if (n == 3 && (s[0] | 0x20) == 'p' && (s[1] | 0x20) == 's' && s[2] == '5') return PKB_PROMPTS_PS4;
+    for (i = 0; i < PKB_N_PROMPTS; i++) {
