+/* Per-object wake latch. A producer commonly pushes before the consumer has
+ * executed its WAIT_SIGNAL (the SPU-side pop registers in the queue line and
+ * only then parks). Signalling "nobody parked" used to lose that wake for good:
+ * the consumer parked afterwards and slept with a full queue. Latch the object
+ * and let the next park consume it instead of sleeping. */
+#define SPU_OBJ_LATCH_MAX 16
+static volatile uint32_t s_obj_latch[SPU_OBJ_LATCH_MAX];
+
+static void spu_obj_latch_set(uint32_t obj)
+{
+    if (!obj) return;
+    for (int i = 0; i < SPU_OBJ_LATCH_MAX; i++)
+        if (s_obj_latch[i] == obj) return;
+    for (int i = 0; i < SPU_OBJ_LATCH_MAX; i++)
+        if (s_obj_latch[i] == 0) { s_obj_latch[i] = obj; return; }
+}
