+/* Wake every parked task whose WAIT_SIGNAL object is `wait_obj`, whichever
+ * taskset it belongs to. A SPURS LF queue stores its `eaSignal` as the
+ * CellSpurs instance (low bit tagged), NOT the taskset EA: cellSpursLFQueue.c
+ * used to pass that value to spu_taskset_signal_task, which latched the bit in
+ * the wrong object's `signalled` bitset, so a consumer parked on the queue
+ * never woke and the PPU waited forever on the completion flag (Super Stardust
+ * HD: every pop sat in WAIT_SIGNAL while the loader's pushes were ignored).
+ * The waiter registered on the queue names the queue EA as its wait object, so
+ * match on that. Returns how many tasks were woken. */
+int spu_taskset_signal_parked_object(uint32_t wait_obj)
+{
+    if (!wait_obj) return 0;
+    int n = 0;
+    for (int i = 0; i < SPU_PARKED_MAX; i++) {
+        uint64_t k = s_parked[i];
+        if (!k) continue;
+        if (s_parked_obj[i] != wait_obj) continue;
+        spu_taskset_signal_task((uint32_t)(k >> 32), (uint32_t)(k & 0xFFFFFFFFu) - 1u);
+        n++;
+    }
+    return n;
+}
