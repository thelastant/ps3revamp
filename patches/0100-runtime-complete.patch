+/* The sensor re-check (pad_sensor_tick): log when sensors come on, and once at the end of the window without both. */
+static void pad_sdl_sensor_recheck(int p, PadSdlGamepad* gc, unsigned long long now)
+{
+    PadSensorWatch* w = &s_sdl_sensors[p];
+    int r = pad_sensor_tick(w, now, pad_sdl_has_sensor, pad_sdl_enable_sensor, gc);
+    if (!r) return;
+    double t = (double)(now - w->open_ms) / 1000.0;
+    if (r & PAD_SENSOR_ENDED)
+        printf("[pad] port %d: sensors %s after the %.0f s re-check (accel %s, gyro %s)\n", p,
+               pad_sensor_set_name(w->on), t, pad_sensor_why(w, 0), pad_sensor_why(w, 1));
+    else
+        printf("[pad] port %d: sensors %s after %.1f s\n", p, pad_sensor_set_name(w->on), t);
+    fflush(stdout);
+}
