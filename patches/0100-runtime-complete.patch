+/* KZ3 patch 1055: hashed NID lookup for the HLE import dispatch.
+ * Idea from NoahBPeterson/ps3recomp e68e567 ("ppu_hle: hashed NID lookup for HLE
+ * dispatch"); this is our own C version, shared by the flat HLE table and the
+ * context-handler table, with a host test (tools/spu/test_nid_index.c).
+ *
+ * ps3_hle_call scanned g_ctx (up to 256) and then g_hle_nids (thousands of
+ * entries) linearly on every firmware import call. The index is an immutable
+ * open-addressed snapshot of "first entry index per NID", rebuilt under a spin
+ * lock only when the table's count changed since the last build (registration
+ * happens at init), and published with an atomic pointer so lookups never lock.
+ * Old snapshots are leaked on purpose (a reader may still hold one; rebuilds
+ * happen a handful of times per run). The first entry for a NID wins, as with
+ * the linear scans. Tables are arrays of structs whose first member is the
+ * uint32_t NID (ps3_nid_entry, the g_ctx entries), addressed by base + stride.
+ *
+ * KZ3_NID_LINEAR=1 restores the linear scans (A/B only). */
+#ifndef KZ3_NID_INDEX_H
+#define KZ3_NID_INDEX_H
+
+#include <stdint.h>
+#include <stdlib.h>
+
+typedef struct kz3_nid_index {
+    uint32_t count;      /* table count this snapshot covers */
+    uint32_t mask;       /* slot count - 1 (power of two, >= 2 * count) */
+    int32_t  slot[1];    /* entry index or -1 */
+} kz3_nid_index;
+
+typedef struct kz3_nid_cache {
+    kz3_nid_index* ix;   /* current snapshot (atomic) */
+    int            lock; /* rebuild spin lock */
+} kz3_nid_cache;
+
+static inline uint32_t kz3_nid_key(const void* base, size_t stride, uint32_t i)
+{
+    return *(const uint32_t*)((const char*)base + (size_t)i * stride);
+}
+
+static inline uint32_t kz3_nid_hash(uint32_t nid)
+{
+    uint32_t h = nid * 2654435761u;
+    return h ^ (h >> 15);
+}
+
+static inline int32_t kz3_nid_linear(const void* base, size_t stride, uint32_t n, uint32_t nid)
+{
+    for (uint32_t i = 0; i < n; i++)
+        if (kz3_nid_key(base, stride, i) == nid) return (int32_t)i;
+    return -1;
+}
+
+static inline kz3_nid_index* kz3_nid_index_build(const void* base, size_t stride, uint32_t n)
+{
+    uint32_t size = 16;
+    while (size < 2 * n) size <<= 1;
+    kz3_nid_index* nx = (kz3_nid_index*)malloc(sizeof(kz3_nid_index) + (size - 1) * sizeof(int32_t));
+    if (!nx) return NULL;
+    nx->count = n; nx->mask = size - 1;
+    for (uint32_t i = 0; i < size; i++) nx->slot[i] = -1;
+    for (uint32_t i = 0; i < n; i++) {
+        const uint32_t key = kz3_nid_key(base, stride, i);
+        for (uint32_t h = kz3_nid_hash(key) & nx->mask;; h = (h + 1) & nx->mask) {
+            if (nx->slot[h] < 0) { nx->slot[h] = (int32_t)i; break; }
+            if (kz3_nid_key(base, stride, (uint32_t)nx->slot[h]) == key) break;   /* first wins */
+        }
+    }
+    return nx;
+}
+
+static inline int32_t kz3_nid_index_find(const kz3_nid_index* ix, const void* base, size_t stride, uint32_t nid)
+{
+    for (uint32_t h = kz3_nid_hash(nid) & ix->mask;; h = (h + 1) & ix->mask) {
+        const int32_t k = ix->slot[h];
+        if (k < 0) return -1;
+        if (kz3_nid_key(base, stride, (uint32_t)k) == nid) return k;
+    }
+}
+
+/* Index of the first entry with this NID among the first n, or -1. */
+static inline int32_t kz3_nid_cache_find(kz3_nid_cache* c, const void* base, size_t stride, uint32_t n, uint32_t nid)
+{
+    if (n == 0) return -1;
+    kz3_nid_index* ix = __atomic_load_n(&c->ix, __ATOMIC_ACQUIRE);
+    if (!ix || ix->count != n) {
+        while (__atomic_exchange_n(&c->lock, 1, __ATOMIC_ACQUIRE)) { }
+        ix = __atomic_load_n(&c->ix, __ATOMIC_ACQUIRE);
+        if (!ix || ix->count != n) {
+            kz3_nid_index* nx = kz3_nid_index_build(base, stride, n);
+            if (nx) __atomic_store_n(&c->ix, nx, __ATOMIC_RELEASE);
+            ix = nx;
+        }
+        __atomic_store_n(&c->lock, 0, __ATOMIC_RELEASE);
+        if (!ix) return kz3_nid_linear(base, stride, n, nid);
+    }
+    return kz3_nid_index_find(ix, base, stride, nid);
+}
+
+static inline int kz3_nid_use_linear(void)
+{
+    static int s = -1;
+    if (s < 0) { const char* e = getenv("KZ3_NID_LINEAR"); s = (e && e[0] == '1') ? 1 : 0; }
+    return s;
+}
+
+#endif /* KZ3_NID_INDEX_H */
