+
+static void spu_jobs_del(spu_async_job* j)
+{
+    AcquireSRWLockExclusive(&s_jobs_lock);
+    spu_async_job** pp = &s_jobs_head;
+    while (*pp && *pp != j) pp = &(*pp)->next_active;
+    if (*pp) *pp = j->next_active;
+    ReleaseSRWLockExclusive(&s_jobs_lock);
+    j->next_active = NULL;
