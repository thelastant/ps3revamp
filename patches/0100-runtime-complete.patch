+/* 1 = SDL serves the pads. Windows: SDL3.dll from the exe's folder, then System32 (never the working directory or
+ * PATH); PAD_SDL=0 keeps XInput. Elsewhere: libSDL3.so.0 from the loader's path. */
+static int pad_sdl_init(void)
+{
+    if (!s_sdl_inited) {
+        s_sdl_inited = -1;
+        const char* e = getenv("PAD_SDL");
+        if (e && strcmp(e, "0") == 0) {
+            printf("[pad] PAD_SDL=0: %s\n", PAD_BACKEND_XINPUT ? "XInput backend" : "no pad backend");
+            fflush(stdout);
+            return 0;
+        }
+#ifdef _WIN32
+        HMODULE m = LoadLibraryExW(L"SDL3.dll", NULL, LOAD_LIBRARY_SEARCH_APPLICATION_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+        #define PAD_SDL_SYM(n) (void (*)(void))GetProcAddress(m, n)
+        const char* lib = "SDL3.dll";
+#else
+        void* m = dlopen("libSDL3.so.0", RTLD_NOW | RTLD_LOCAL);
+        #define PAD_SDL_SYM(n) (void (*)(void))dlsym(m, n)
+        const char* lib = "libSDL3.so.0";
+#endif
+        const char* fb = PAD_BACKEND_XINPUT ? "XInput backend (PlayStation pads only through Steam Input)"
+                                            : "no pad backend";
+        if (!m) { printf("[pad] no %s: %s\n", lib, fb); fflush(stdout); return 0; }
+#define PAD_SDL_LOAD(ret, name, args) \
+        p_##name = (name##_fn)PAD_SDL_SYM(#name); \
+        if (!p_##name) { printf("[pad] %s lacks %s (SDL 3.2 or newer needed): %s\n", lib, #name, fb); \
+                         fflush(stdout); return 0; }
+        PAD_SDL_FUNCS(PAD_SDL_LOAD)
+#undef PAD_SDL_LOAD
+#undef PAD_SDL_SYM
+        PSDL(SDL_SetMainReady)();
+        /* Hints (pad_host.h pad_sdl_hints), at SDL_HINT_OVERRIDE so the environment cannot change them, with a log line
+         * when it tried: ALLOW_BACKGROUND_EVENTS = 1 (the game window is not SDL's: take pad input as XInput does);
+         * the HIDAPI drivers for DualShock 4, DualSense, Switch Pro and Xbox pads (their own reports: rumble, sensors,
+         * labels; SDL3's defaults); ENHANCED_REPORTS = 1 (SDL 3.4.16's default; "0" keeps a Bluetooth PlayStation pad
+         * from listing its sensors); RAWINPUT = 0 (ASSUMPTION: RawInput needs a window message loop owned by
+         * SDL, and the pad is polled from game threads; without it, Xbox pads go through SDL's XInput driver). */
+        for (size_t h = 0; h < sizeof pad_sdl_hints / sizeof pad_sdl_hints[0]; h++) {
+            const char* env = getenv(pad_sdl_hints[h][0]);
+            if (env && strcmp(env, pad_sdl_hints[h][1]) != 0)
+                printf("[pad] SDL hint %s=%.40s from the environment replaced by %s\n", pad_sdl_hints[h][0], env,
+                       pad_sdl_hints[h][1]);
+            if (!PSDL(SDL_SetHintWithPriority)(pad_sdl_hints[h][0], pad_sdl_hints[h][1], PAD_SDL_HINT_OVERRIDE))
+                printf("[pad] SDL hint %s not set: %s\n", pad_sdl_hints[h][0], PSDL(SDL_GetError)());
+        }
+        /* DualShock 3 drivers: normal priority, so an environment variable decides; the line says which
+         * value took effect. */
+        for (size_t h = 0; h < sizeof pad_sdl_soft_hints / sizeof pad_sdl_soft_hints[0]; h++) {
+            char line[240];
+            const char* env = getenv(pad_sdl_soft_hints[h][0]);
+            pad_sdl_soft_hint_text(line, sizeof line, pad_sdl_soft_hints[h][0], pad_sdl_soft_hints[h][1], env);
+            if (!env) PSDL(SDL_SetHintWithPriority)(pad_sdl_soft_hints[h][0], pad_sdl_soft_hints[h][1], PAD_SDL_HINT_NORMAL);
+            printf("[pad] %s\n", line);
+        }
+        for (size_t h = 0; h < sizeof pad_sdl_env_hints / sizeof pad_sdl_env_hints[0]; h++) {
+            const char* env = getenv(pad_sdl_env_hints[h]);
+            if (env) {
+                char v[120];
+                pad_log_clean(v, sizeof v, env);
+                printf("[pad] SDL hint %s=%s from the environment (kept)\n", pad_sdl_env_hints[h], v);
+            }
+        }
+        if (!PSDL(SDL_InitSubSystem)(PAD_SDL_INIT_GAMEPAD)) {
+            printf("[pad] SDL gamepad init failed (%s): %s\n", PSDL(SDL_GetError)(), fb);
+            fflush(stdout);
+            return 0;
+        }
+        /* Nobody pumps this SDL's event queue: polled state only (SDL_UpdateGamepads). */
+        PSDL(SDL_SetGamepadEventsEnabled)(false);
+        PSDL(SDL_SetJoystickEventsEnabled)(false);
+        s_sdl_lock = PSDL(SDL_CreateMutex)();
+        int v = PSDL(SDL_GetVersion)();
+        printf("[pad] SDL %d.%d.%d gamepad backend\n", v / 1000000, v / 1000 % 1000, v % 1000);
+        fflush(stdout);
+        s_sdl_inited = 1;
+    }
+    if (s_sdl_inited < 0) return 0;
+    PSDL(SDL_LockMutex)(s_sdl_lock);
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) {
+        s_sdl_controllers[p] = NULL;
+        s_sdl_slot_id[p] = -1;
+        s_rumble_lo[p] = s_rumble_hi[p] = 0;
+        memset(&s_sdl_sensors[p], 0, sizeof s_sdl_sensors[p]);
+    }
+    s_sdl_enum_ms = 0;
+    PSDL(SDL_UnlockMutex)(s_sdl_lock);
+    return 1;
+}
+
+static void pad_sdl_shutdown(void)
+{
+    PSDL(SDL_LockMutex)(s_sdl_lock);
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) {
+        if (s_sdl_controllers[p]) PSDL(SDL_CloseGamepad)(s_sdl_controllers[p]);
+        s_sdl_controllers[p] = NULL;
+        s_sdl_slot_id[p] = -1;
+    }
+    PSDL(SDL_UnlockMutex)(s_sdl_lock);
+}
